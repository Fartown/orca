{
  "schemaVersion": 1,
  "defaultBaseRef": "origin/main",
  "aliases": [
    { "prefix": "@/", "replacement": "src/renderer/src/" },
    { "prefix": "@renderer/", "replacement": "src/renderer/src/" }
  ],
  "policies": [
    {
      "id": "mobile-terminal-surface-recovery",
      "description": "Original-surface recovery for mobile workspace activation, with one product seam and feature-owned admission policy.",
      "rules": [
        {
          "id": "mobile-terminal-surface-recovery-worktree-scope",
          "type": "change-scope",
          "comparison": "worktree",
          "whenChanged": [
            "src/renderer/src/mobile-terminal-surface-recovery/**",
            "docs/issue/手机打开工作区终端身份恢复/**"
          ],
          "allowedPaths": [
            "src/renderer/src/mobile-terminal-surface-recovery/**",
            "src/renderer/src/lib/worktree-agent-live-surface-adoption.ts",
            "src/renderer/src/lib/worktree-agent-activation-gate.test.ts",
            "docs/issue/手机打开工作区终端身份恢复/**",
            "docs/issue/README.md",
            "config/fork-features.jsonc",
            "config/architecture-policies.jsonc",
            ".gitignore"
          ],
          "message": "Change is outside the mobile terminal surface recovery feature scope."
        }
      ]
    },
    {
      "id": "native-chat-view-recovery",
      "description": "Restore the existing terminal/chat view action without creating or resuming provider sessions.",
      "rules": [
        {
          "id": "native-chat-view-recovery-worktree-scope",
          "type": "change-scope",
          "comparison": "worktree",
          "whenChanged": [
            "src/renderer/src/native-chat-view-recovery/**",
            "docs/issue/终端聊天视图恢复/**"
          ],
          "allowedPaths": [
            "src/renderer/src/native-chat-view-recovery/**",
            "docs/issue/终端聊天视图恢复/**",
            "src/renderer/src/components/tab-bar/SortableTabContextMenu.tsx",
            "src/renderer/src/components/tab-bar/SortableTabContextMenu.test.tsx",
            "config/fork-features.jsonc",
            "config/architecture-policies.jsonc",
            "docs/issue/README.md",
            ".gitignore"
          ],
          "message": "Change is outside terminal chat view recovery."
        }
      ]
    },
    {
      "id": "terminal-launch-diagnostics",
      "description": "Observational terminal launch tracing only; no runtime ownership or wire changes.",
      "rules": [
        {
          "id": "terminal-launch-diagnostics-worktree-scope",
          "type": "change-scope",
          "comparison": "worktree",
          "whenChanged": [
            "src/shared/terminal-launch-diagnostics/**",
            "src/main/terminal-launch-diagnostics/**",
            "src/renderer/src/terminal-launch-diagnostics/**",
            "docs/issue/终端创建链路诊断/**"
          ],
          "allowedPaths": [
            "src/shared/terminal-launch-diagnostics/**",
            "src/main/terminal-launch-diagnostics/**",
            "src/renderer/src/terminal-launch-diagnostics/**",
            "docs/issue/终端创建链路诊断/**",
            "src/main/runtime/rpc/dispatcher.ts",
            "src/main/ipc/pty/runtime/spawn.ts",
            "src/main/ipc/pty/runtime/spawn-execute.ts",
            "src/main/daemon/daemon-terminal-admission.ts",
            "src/renderer/src/store/terminals/terminal-startup-queues.ts",
            "src/renderer/src/runtime/web-runtime-terminal-creation.ts",
            "src/main/observability/index.ts",
            "src/renderer/src/lib/sleeping-agent-session-launch.ts",
            "src/renderer/src/components/tab-group/AiVaultSessionDropLayer.tsx",
            "src/renderer/src/lib/launch-ai-vault-session-and-reveal.ts",
            "src/renderer/src/components/terminal-pane/pty-connection/deferred-cold-restore-and-snapshot.ts",
            "src/renderer/src/hooks/ipc-events/terminal-request-ipc-bridge.ts",
            "src/renderer/src/store/terminals/terminal-tab-creation.ts",
            "src/main/ipc/crash-reporting-renderer-breadcrumbs.ts",
            "config/fork-features.jsonc",
            "config/architecture-policies.jsonc",
            ".gitignore",
            "docs/issue/README.md",
            "src/renderer/src/lib/launch-agent-in-new-tab-web-runtime.test.ts",
            "src/renderer/src/components/terminal-pane/pty-connection-agent-session-resume.spec.ts",
            "src/renderer/src/components/terminal-pane/pty-connection-sleeping-resume-banner.spec.ts"
          ],
          "message": "Change is outside terminal launch diagnostics."
        }
      ]
    },
    {
      "id": "integration-builds",
      "description": "Fork packages and integration-only application updates reuse upstream build and install machinery.",
      "rules": [
        {
          "id": "integration-builds-worktree-scope",
          "type": "change-scope",
          "comparison": "worktree",
          "whenChanged": [
            "src/cli/integration-builds/**",
            "src/renderer/src/integration-builds/**",

            ".github/workflows/fork-integration-build.yml",
            "config/scripts/mobile-web-bundle-packaging-workflow-contract.test.mjs",
            "config/scripts/integration-builds/**",
            "src/shared/integration-builds/**",
            "src/main/integration-builds/**",
            "mobile/src/integration-builds/**",
            "mobile/modules/orca-app-update/**",
            "docs/issue/集成分支自动出包/**"
          ],
          "allowedPaths": [
            "src/cli/integration-builds/**",
            "src/renderer/src/integration-builds/**",
            "src/main/serve-update-handoff.ts",
            "src/cli/runtime/launch.ts",
            "src/cli/runtime/serve-orcad-launch.ts",
            "src/cli/runtime/serve-update-supervisor.ts",
            "src/renderer/src/web/preload-api/web-updater-api.ts",

            "config/scripts/ci-draft-pr-admission.test.mjs",
            ".github/workflows/pr.yml",
            ".github/workflows/ci-closed-pr-caches.yml",
            "config/scripts/ci-dependency-download-cache.test.mjs",
            ".github/workflows/fork-integration-build.yml",
            ".github/workflows/pr.yml",
            "config/scripts/pr-preflight-gates.test.mjs",
            "config/scripts/ci-dependency-download-cache.test.mjs",
            ".github/workflows/ci-cache-warmup-platform-jobs.yml",
            "config/scripts/mobile-web-bundle-packaging-workflow-contract.test.mjs",
            "config/scripts/integration-builds/**",
            "src/shared/integration-builds/**",
            "src/main/integration-builds/**",
            "mobile/src/integration-builds/**",
            "mobile/modules/orca-app-update/**",
            "mobile/app.config.js",
            "mobile/app/_layout.tsx",
            "mobile/src/app-update/app-update-runtime.ts",
            "mobile/src/settings/about-screen.tsx",
            "src/main/updater/updater-release-feed.ts",
            "src/main/updater/updater-nudge.ts",
            "src/main/updater-changelog.ts",
            "docs/issue/集成分支自动出包/**",
            "config/fork-features.jsonc",
            "config/architecture-policies.jsonc",
            "docs/issue/README.md",
            ".gitignore",
            "mobile/package.json",
            "mobile/pnpm-lock.yaml",
            "config/scripts/check-path-literal-ratchet.mjs",
            "config/scripts/pr-preflight-gates.test.mjs",
            "config/scripts/win32-test-lane-registration.test.mjs",
            "config/scripts/ci-closed-pr-cancellation.test.mjs"
          ],
          "message": "Change is outside the integration build feature."
        }
      ]
    },
    {
      "id": "fork-upstream-diff-budget",
      "description": "The fork's whole diff against upstream stays inside one reviewed allowlist: feature-owned paths plus the seams they register into.",
      "rules": [
        {
