    {
      "id": "sidebar-project-merge",
      "description": "Only sidebar classification changes; native actions and ownership remain unchanged.",
      "rules": [
        {
          "id": "sidebar-project-merge-worktree-scope",
          "type": "change-scope",
          "comparison": "worktree",
          "whenChanged": [
            "mobile/src/sidebar-project-merge/**",
            "src/shared/sidebar-project-merge/**",
            "docs/issue/侧栏项目合并/**"
          ],
