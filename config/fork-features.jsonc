        "src/renderer/src/lib/worktree-activation.ts",
        "src/renderer/src/runtime/runtime-client-target.ts",
        "src/renderer/src/runtime/runtime-rpc-client.ts",
        "src/renderer/src/store/index.ts",
        "src/renderer/src/store/selectors.ts",
        "src/shared/agent-status-types.ts",
        "src/shared/child-process/process-spec.ts",
        "src/shared/child-process/run-process.ts",
        "src/shared/pty-liveness-verdict.ts",
        "src/shared/runtime-terminal-contracts.ts",
        "src/shared/sha256.ts"
      ],
      "policyId": "goals-native-feature",
      "ownedPaths": [
        "src/main/goals/**",
        "src/shared/goals/**",
        "src/renderer/src/goals/**",
        "src/renderer/src/components/goals/**",
        "src/renderer/src/components/cmd-j/goal-quick-actions.ts",
        "src/main/runtime/rpc/methods/goals.ts",
