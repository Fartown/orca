{
  "extends": "../../../config/tsconfig.e2e.json",
  "include": [
    "../issues-session-name-file-chain.unit.test.ts",
    "../../../src/renderer/src/env.d.ts",
    "../../../src/types/**/*"
  ],
  "compilerOptions": {
    // Why electron here and not in the shared e2e base: this narrow program pulls renderer and
    // main modules transitively, and upstream now references the global `Electron` namespace and
