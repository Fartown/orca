        "src/shared/document-preview-size/document-preview-size-limit.ts",
        "src/main/document-preview-size/document-preview-content-type.ts"
      ],
      "seams": [
        {
          "file": "src/shared/document-preview/doc-preview-file-access.ts",
          "mustContain": "DOCUMENT_PREVIEW_TEXT_MAX_BYTES",
          "why": "the execution host accepts the document-specific text limit"
        },
        {
          "file": "src/main/browser/document-preview/doc-preview-file-reader.ts",
          "mustContain": "readDocumentPreviewInChunks",
          "why": "Paired runtime reads assemble bounded transport chunks under the shared document cap."
        },
        {
          "file": "src/main/runtime/files/file-reads.ts",
          "mustContain": "DOCUMENT_PREVIEW_TEXT_MAX_BYTES",
          "why": "local document reads no longer inherit the mobile text cap"
        },
        {
          "file": "src/main/browser/document-preview/doc-preview-file-reader.test.ts",
          "mustContain": "readDocPreviewFile",
          "why": "Paired runtime preview reads preserve document size and grant checks."
        },
        {
          "file": "src/shared/rpc-contract/filesystem/files-params.ts",
          "mustContain": "DocumentPreviewChunkRequest.optional()",
          "why": "optional scoped chunks retain old-client full-response behavior"
        },
        {
          "file": "src/main/runtime/rpc/methods/files/files.ts",
          "mustContain": "params.chunk",
          "why": "forward document-specific chunk requests through canonical authorization"
        },
        {
          "file": "src/main/browser/document-preview/doc-preview-protocol.ts",
          "mustContain": "media-src 'self' data:",
          "why": "inline data: recordings in previewed reports render like inline images instead of failing default-src"
        }
      ],
      "tests": [
        "src/main/document-preview-size/document-preview-size.test.ts",
        "src/main/document-preview-size/document-preview-runtime.integration.test.ts",
        "src/main/document-preview-size/document-preview-chunk-reader.test.ts"
      ],
