          "why": "Keep the feature contract and its exhaustive integration checks aligned."
        },
        {
          "file": "config/scripts/static-analysis/renderer-styles/check-has-restyle-scope.mjs",
          "mustContain": "':(exclude)src/renderer/src/components/self-hosted-artifacts/share-viewer'",
