            "**/*.spec.ts",
            "src/main/runtime/rpc/methods/local-task-link-methods.ts",
            "src/main/runtime/rpc/methods/local-task-dispatcher-methods.ts",
            "src/main/startup/open-routing/orca-deep-link-url.ts",
            "src/main/startup/main-process-state.ts",
            "src/main/window/activation/macos-desktop-handoff.ts"
          ],
          "forbiddenTargets": ["src/main/local-tasks/**", "src/shared/local-tasks/**"],
          "importTextHints": ["local-tasks"],
          "message": "A native main-process module imports the local task library; register through main-process-local-tasks.ts or the RPC manifest instead."
        },
        {
          "id": "renderer-native-modules-do-not-depend-on-local-tasks",
          "type": "dependency-boundary",
          "sourceFiles": ["src/renderer/src/**/*.ts", "src/renderer/src/**/*.tsx"],
          "exceptPaths": [
            "src/renderer/src/components/sidebar/workspace-card/review/WorkspaceAttachmentSearch.tsx",
            "src/renderer/src/components/sidebar/workspace-card/surface/worktree-card-option-items.tsx",
