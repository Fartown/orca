            "src/main/artifacts/artifact-cloud-config.test.ts",
            "src/main/artifacts/artifact-cloud-service.ts",
            "src/main/self-hosted-artifacts/**",
            "docs/issue/自托管产物后端/**",
            "config/architecture-policies.jsonc",
            "AGENTS.md",
            "config/fork-features.jsonc",
            "config/scripts/check-fork-features.mjs",
            "config/scripts/check-fork-features.test.mjs",
            "config/scripts/run-fork-feature-checks.mjs",
            "config/scripts/check-fork-docs.mjs",
            "config/scripts/check-fork-docs.test.mjs",
            "config/scripts/report-upstream-seam-changes.mjs",
            "config/scripts/sync-upstream.mjs",
            ".github/workflows/sync-upstream.yml",
            ".github/workflows/track-community-prs.yaml",
            "docs/reference/fork-maintenance.md",
            "docs/issue/**",
            "docs/maintenance/**"
          ],
          "message": "Change is outside the self-hosted artifact backend and its journal."
        }
      ]
    },
    {
      "id": "remote-workspace-absolute-path-open",
      "description": "The tab create entry opens absolute paths on the workspace's owning host; the host policy lives in its own module and enters the omnibox only through registered seams (REQ-301～REQ-306).",
      "rules": [
        {
          "id": "remote-workspace-absolute-path-open-worktree-scope",
          "type": "change-scope",
          "comparison": "worktree",
          "whenChanged": [
            "src/renderer/src/components/tab-entry-remote-path/**",
            "docs/issue/远程工作区绝对路径打开/**"
          ],
          "allowedPaths": [
            "src/renderer/src/components/tab-entry-remote-path/**",
            "docs/issue/远程工作区绝对路径打开/**",
            "src/renderer/src/components/tab-bar/tab-create-entry-action.ts",
            "src/renderer/src/components/tab-bar/tab-create-entry-action.test.ts",
            "src/renderer/src/components/tab-bar/tab-create-entry-classifier.ts",
            "src/renderer/src/components/tab-bar/tab-create-entry-classifier.test.ts",
            "src/renderer/src/components/tab-bar/tab-create-entry-absolute-file.ts",
            "src/renderer/src/components/tab-bar/TabBarCreateEntry.tsx",
