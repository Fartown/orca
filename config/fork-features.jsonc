      "seams": [
        {
          "file": "src/main/orcad/orcad-push-startup.test.ts",
          "mustContain": "toHaveBeenCalledTimes(2)",
          "why": "Verify hook and artifact settings subscriptions are cleaned up on host shutdown."
        },
        {
          "file": "src/main/startup/runtime-startup/main-process-runtime-service.ts",
          "mustContain": "startArtifactShareForMainProcess",
          "why": "the share service follows the app and replaces the cloud artifact service"
        },
        {
          "file": "src/main/startup/quit/main-process-quit.ts",
          "mustContain": "stopArtifactShareForMainProcess",
          "why": "quitting the app stops serving and releases the port"
        },
        {
          "file": "src/main/runtime/rpc/methods/rpc-method-registry.ts",
          "mustContain": "...ARTIFACT_SHARE_METHODS",
          "why": "artifactShare.* RPC methods reach the renderer, CLI and paired clients"
        },
        {
          "file": "src/main/runtime/rpc/responses/dispatcher-error-response.ts",
          "mustContain": "mapArtifactShareRpcError",
          "why": "sharing failures keep their code over RPC (errors.ts is pinned by reference parity)"
        },
        {
          "file": "src/shared/rpc-contract/rpc-params-catalog.generated.ts",
          "mustContain": "artifactShare.share",
          "why": "generated params catalog lists the artifactShare methods"
        },
        {
          "file": "src/renderer/src/components/editor/panel/header/EditorPanelHeader.tsx",
          "mustContain": "EditorFileLanShareButton",
