        {
          "id": "main-native-modules-do-not-depend-on-local-tasks",
          "type": "dependency-boundary",
          "sourceFiles": ["src/main/**/*.ts", "src/main/**/*.tsx"],
          "exceptPaths": [
            "src/main/local-tasks/**",
            "src/main/index.ts",
            "src/main/startup/main-process-local-tasks.ts",
            "src/main/runtime/rpc/methods/local-tasks.ts",
