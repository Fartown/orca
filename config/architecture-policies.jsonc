        }
      ]
    },
    {
      "id": "cross-version-wire-fixture-compat",
      "description": "Keep historical cross-version wire checkouts usable when the terminal protocol file moves uniquely.",
      "rules": [
        {
          "id": "cross-version-wire-fixture-compat-worktree-scope",
          "type": "change-scope",
          "comparison": "worktree",
          "whenChanged": [
            "config/scripts/cross-version-wire-fixture-compat/**",
            "docs/issue/跨版本Wire夹具兼容/**",
            "tests/e2e/cross-version-wire/release-checkouts/release-checkout.unit.test.ts",
            "tests/e2e/cross-version-wire/release-checkouts/release-checkout.ts",
            "config/scripts/daemon-protocol/admission/check-daemon-protocol-crossing.mjs"
          ],
          "allowedPaths": [
            "config/scripts/cross-version-wire-fixture-compat/**",
            "docs/issue/跨版本Wire夹具兼容/**",
            "tests/e2e/cross-version-wire/release-checkouts/release-checkout.unit.test.ts",
            "tests/e2e/cross-version-wire/release-checkouts/release-checkout.ts",
            "config/scripts/daemon-protocol/admission/check-daemon-protocol-crossing.mjs",
            ".gitignore",
            "config/fork-features.jsonc",
            "config/architecture-policies.jsonc",
            "docs/issue/README.md"
          ],
          "message": "Change is outside cross-version wire fixture compatibility."
        }
      ]
    },
    {
      "id": "markdown-review-anchor-recovery",
      "description": "Preserve review note access after Markdown source changes.",
      "rules": [
        {
          "id": "markdown-review-anchor-recovery-worktree-scope",
          "type": "change-scope",
          "comparison": "worktree",
          "whenChanged": [
            "src/renderer/src/components/markdown-review-anchor-recovery/**",
            "docs/issue/Markdown评论失效锚点恢复/**",
            "tests/e2e/markdown-review-anchor-recovery.spec.ts",
            "src/renderer/src/components/editor/rich-markdown/review/rich-markdown-review-note-positioning.ts",
            "src/renderer/src/components/editor/rich-markdown/review/rich-markdown-review-note-layout.ts",
            "src/renderer/src/components/editor/rich-markdown/review/RichMarkdownReviewNoteLayer.tsx"
          ],
          "allowedPaths": [
            "src/renderer/src/components/markdown-review-anchor-recovery/**",
            "docs/issue/Markdown评论失效锚点恢复/**",
            "tests/e2e/markdown-review-anchor-recovery.spec.ts",
            "src/renderer/src/components/editor/rich-markdown/review/rich-markdown-review-note-positioning.ts",
            "src/renderer/src/components/editor/rich-markdown/review/rich-markdown-review-note-layout.ts",
            "src/renderer/src/components/editor/rich-markdown/review/RichMarkdownReviewNoteLayer.tsx",
            "src/renderer/src/i18n/locales/en.json",
            "src/renderer/src/i18n/locales/zh.json",
            ".gitignore",
            "config/fork-features.jsonc",
            "config/architecture-policies.jsonc",
            "docs/issue/README.md"
          ],
          "message": "Change is outside Markdown review anchor recovery."
        }
      ]
    },
    {
      "id": "markdown-link-reader",
      "description": "A line-numbered link to a Markdown file keeps the tab in the reader; the decision lives in its own module and reaches the link paths only through registered seams (REQ-1541～REQ-1544).",
      "rules": [
        {
          "id": "markdown-link-reader-worktree-scope",
          "type": "change-scope",
          "comparison": "worktree",
          "whenChanged": [
            "src/renderer/src/markdown-link-reader/**",
            "mobile/src/markdown-link-reader/**",
            "docs/issue/Markdown链接阅读器打开/**"
          ],
          "allowedPaths": [
