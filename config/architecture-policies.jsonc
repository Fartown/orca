            "src/renderer/src/components/worktree-jump/rows/worktree-jump-palette-entry.tsx",
            "src/renderer/src/lib/workspace/search/worktrees/worktree-palette-document.ts",
            "src/renderer/src/components/worktree-jump/workspaces/use-worktree-jump-palette-worktrees.ts",
            "src/renderer/src/local-tasks/**",
            "src/renderer/src/components/local-tasks/**",
            "src/renderer/src/components/cmd-j/local-task-quick-actions.ts",
            "src/renderer/src/app-shell/AppBackgroundServices.tsx",
            "src/renderer/src/components/task-page/SourceBar.tsx",
            "src/renderer/src/components/task-page/Frame.tsx",
            "src/renderer/src/components/cmd-j/quick-actions.ts",
            "src/renderer/src/components/settings/navigation/settings-navigation-workflow-sections.ts",
            "src/renderer/src/components/settings/page/settings-page-renderer.tsx",
            "**/*.test.ts",
            "**/*.test.tsx",
            "src/renderer/src/store/slices/hosted-review/refresh/use-visible-review-refresh-reporting.ts",
            "src/renderer/src/components/new-workspace/composer/NewWorkspaceComposerModal.tsx",
            "src/renderer/src/components/sidebar/chrome/SidebarTaskNavButton.tsx",
            "src/main/runtime/rpc/server/runtime-rpc-websocket-dispatch.ts",
