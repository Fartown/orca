            "mobile/src/markdown-link-reader/**",
            "docs/issue/Markdown链接阅读器打开/**",
            "src/renderer/src/components/terminal-pane/links/files/terminal-file-link-editor-open.ts",
            "src/renderer/src/store/slices/editor/markdown/markdown-link-action.ts",
            "src/renderer/src/components/editor/markdown-preview/links/markdown-preview-link-actions.ts",
            "mobile/src/files/markdown/MobileMarkdownPreviewModeBar.tsx",
            ".gitignore",
            "config/fork-features.jsonc",
            "config/architecture-policies.jsonc",
            "docs/issue/**"
          ],
          "message": "Change is outside the Markdown link reader feature and its journal."
        }
      ]
    }
  ]
