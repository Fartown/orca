          "file": "src/renderer/src/components/settings/navigation/settings-navigation-workflow-sections.ts",
          "mustContain": "getLanArtifactsSettingsSearchEntries",
          "why": "settings search finds the local network sharing rows"
        },
        {
          "file": "src/cli/dispatch/handler-group-manifest.ts",
          "mustContain": "ARTIFACT_SHARE_HANDLER_GROUP",
          "why": "orca artifacts commands share over the local network; the group lives in the feature folder"
        },
        {
          "file": "src/cli/specs/artifacts.ts",
          "mustContain": "'service', 'status'",
          "why": "orca artifacts service status is a registered command"
        },
        {
          "file": "config/electron-builder.config.cjs",
          "mustContain": "artifactShareViewerExtraResource",
          "why": "packaged apps ship the share page script"
        },
        {
