    {
      "id": "gitea-host-verification",
      "title": "Gitea 主机识别校验",
      "goal": "不认识的自建代码平台先确认是不是 Gitea，明确不是时不再冒充 Gitea 发请求，真 Gitea 不受影响",
      "journal": "docs/issue/Gitea主机识别校验/journal.md",
      "dependsOn": [
        "src/main/git/remotes/coalesced-probe.ts",
        "src/main/git/remotes/remote-ref-probe-cache.ts",
        "src/main/gitea/repository-ref.ts",
        "src/main/lib/unread-response-body.ts",
        "src/main/source-control/forge-provider-detection.ts"
      ],
      "policyId": "gitea-host-verification",
      "ownedPaths": ["src/main/gitea-host-verification/**", "docs/issue/Gitea主机识别校验/**"],
      "requiredFiles": ["src/main/gitea-host-verification/gitea-host-probe.ts"],
      "seams": [
        {
          "file": "src/main/gitea/client.ts",
          "mustContain": "confirmGiteaRepoRef(repo, { apiBaseConfigured: getAuthConfig().apiBaseUrl !== null })",
          "why": "Confirm an unclaimed host is Gitea before treating its remote as a Gitea repository"
        },
        {
          "file": "src/main/gitea/client-scan-invalidation.test.ts",
          "mustContain": "vi.mock('../gitea-host-verification/gitea-host-probe'",
          "why": "Scan-cache tests run after detection; host verification has its own tests"
        },
        {
          "file": "src/main/source-control/hosted-review-gitea.integration.test.ts",
          "mustContain": "url.pathname === '/api/v1/version'",
          "why": "The fake Gitea answers the host probe, and the probe must not carry the token"
        }
      ],
      "tests": ["src/main/gitea-host-verification/gitea-host-probe.test.ts"],
      "checks": [
        "pnpm exec vitest run --config config/vitest.config.ts src/main/gitea-host-verification src/main/gitea src/main/source-control/hosted-review-gitea.integration.test.ts src/main/source-control/hosted-review.test.ts"
      ]
    },
    {
      "id": "plugin-workspace-remote",
      "title": "插件读取工作区远程仓库",
      "goal": "插件能拿到聚焦工作区（本地与 SSH）及工作区列表各行所属仓库的远程地址（去掉凭据），不必在主机上执行命令",
      "journal": "docs/issue/插件读取工作区远程仓库/journal.md",
      "dependsOn": [
        "src/shared/git/remotes/git-remote-error.ts",
        "src/shared/git/remotes/git-remote-identity.ts",
        "src/shared/repository/repo-types.ts",
        "src/shared/worktree/id.ts",
        "src/renderer/src/store/index.ts",
        "src/renderer/src/store/slices/worktrees/listing/worktree-catalog-index.ts",
        "src/renderer/src/store/workspaces/catalog/workspace-record-fields.ts",
        "src/main/plugins/workers/host-api/plugin-host-runtime-call.ts"
      ],
      "policyId": "plugin-workspace-remote",
      "ownedPaths": [
        "src/shared/plugin-workspace-remote/**",
        "src/main/plugin-workspace-remote/**",
        "src/renderer/src/plugin-workspace-remote/**",
        "docs/issue/插件读取工作区远程仓库/**"
      ],
      "requiredFiles": ["src/shared/plugin-workspace-remote/plugin-workspace-remote.ts"],
      "seams": [
        {
          "file": "src/shared/plugins/workers/plugin-host-api-workspace-context.ts",
          "mustContain": "remote: pluginWorkspaceRemoteSchema.optional()",
          "why": "The focused-workspace context plugins read and receive in workspace.changed carries the recorded remote"
        },
        {
          "file": "src/shared/plugins/workers/plugin-host-api-workspace-methods.ts",
          "mustContain": "remote: pluginWorkspaceRemoteSchema.optional()",
          "why": "Each workspace.list row carries its repository's recorded remote"
        },
        {
          "file": "src/main/plugins/runtime/plugin-runtime-binding.ts",
          "mustContain": "withPluginWorkspaceRemote(",
          "why": "The plugin delegate adds the remote once, for readContext and workspace.changed alike"
        },
        {
          "file": "src/main/plugins/workers/host-api/plugin-host-service-bindings.ts",
          "mustContain": "...(context.remote ? { remote: context.remote } : {})",
          "why": "The host services keep the remote when they narrow the runtime context"
        },
        {
          "file": "src/main/plugins/workers/host-api/plugin-workspace-projection.ts",
          "mustContain": "...(context.remote ? { remote: context.remote } : {})",
          "why": "The public context projection passes the remote through"
        },
        {
          "file": "src/main/plugins/workers/host-api/plugin-host-method-bindings.ts",
          "mustContain": "remote?: PluginWorkspaceRemote",
          "why": "The host context type names the optional remote"
        },
        {
          "file": "src/main/plugins/workers/host-api/plugin-host-workspace-list.ts",
          "mustContain": "pluginWorkspaceRemoteForRepo(repoRows, worktree.repoId)",
          "why": "workspace.list reads each row's remote from the repo list it already fetches"
        },
        {
          "file": "src/main/plugins/runtime/plugin-runtime-binding.ts",
          "mustContain": "await withPluginFocusedWorkspaceRemote(context, renderer)",
          "why": "workspace.changed completes a stored SSH context's remote from the window, as readContext does"
        },
        {
          "file": "src/main/plugins/workers/host-api/plugin-host-method-bindings.ts",
          "mustContain": "await resolvePluginReadContext(context, terminals, services.renderer)",
          "why": "readContext asks the window when main's runtime does not own the focused workspace (an orcad-managed SSH host)"
        },
        {
          "file": "src/main/plugins/runtime/plugin-runtime-binding.ts",
          "mustContain": "return { context: await readPluginFocusedWorkspaceElsewhere(renderer) }",
          "why": "workspace.changed and panel replays ask the window the same way"
        },
        {
          "file": "src/shared/plugins/view/plugin-view-protocol.ts",
          "mustContain": "| { kind: 'read-focused-workspace' }",
          "why": "The window request that reads the focused worktree record"
        },
        {
          "file": "src/main/plugins/view/plugin-view-reply-schema.ts",
          "mustContain": "workspace: pluginFocusedWorkspaceSchema.nullable().optional()",
          "why": "Main's reply check keeps the window's answer instead of stripping it"
        },
        {
          "file": "src/main/plugins/view/plugin-host-renderer-actions.ts",
          "mustContain": "askForReply({ kind: 'read-focused-workspace' })",
          "why": "The plugin host's window actions expose the read"
        },
        {
          "file": "src/renderer/src/components/plugins/view/plugin-view-request-handler.ts",
          "mustContain": "return readPluginFocusedWorkspace(request)",
          "why": "The window answers the read from its own workspace records"
        },
        {
          "file": "docs/reference/plugin-host-api.md",
          "mustContain": "remote?: { name: string; url: string }",
          "why": "Generated from the host API table; regenerate instead of editing"
        },
        {
          "file": "resources/plugins/types/orca-host.d.ts",
          "mustContain": "remote?: { name: string; url: string }",
          "why": "Generated from the host API table; regenerate instead of editing"
