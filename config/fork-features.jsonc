    {
      "id": "remote-workspace-absolute-path-open",
      "title": "远程工作区绝对路径打开：「+」弹窗在 SSH 工作区按远端主机打开绝对路径",
      "goal": "弹窗输入绝对路径时本地开本地、SSH 开远端；不按路径位置拦截，归属未解析才不可用",
      "journal": "docs/issue/远程工作区绝对路径打开/journal.md",
      "dependsOn": [
        "src/renderer/src/components/tab-bar/create-entry/tab-create-entry-local-path.ts",
        "src/renderer/src/components/tab-bar/create-entry/tab-create-entry-path-validation.ts",
        "src/renderer/src/lib/workspace/ownership/folder-workspace-connection.ts",
        "src/renderer/src/app-shell/platform/renderer-app-platform.ts",
        "src/renderer/src/lib/workspace/ownership/resolved-worktree-execution-host.ts",
        "src/renderer/src/store/index.ts",
        "src/shared/workspace/identity/workspace-scope.ts"
      ],
      "policyId": "remote-workspace-absolute-path-open",
      "ownedPaths": [
        "src/renderer/src/components/tab-entry-remote-path/**",
        "docs/issue/远程工作区绝对路径打开/**"
      ],
      "requiredFiles": [
        "src/renderer/src/components/tab-entry-remote-path/absolute-path-host-policy.ts",
        "src/renderer/src/components/tab-entry-remote-path/use-tab-entry-absolute-path-context.ts"
      ],
      "seams": [
        {
          "file": "src/renderer/src/components/tab-bar/create-entry/tab-create-entry-action.ts",
          "mustContain": "resolveTabEntryAbsolutePathHostPolicy",
          "why": "the tab create entry resolves the owning host instead of the local-only guard (REQ-302, REQ-305)"
        },
        {
          "file": "src/renderer/src/components/tab-bar/create-entry/tab-create-entry-classifier.ts",
          "mustContain": "absolutePathRemoteBlocked",
          "why": "absolute paths stay unavailable only while the owning host is unresolved (REQ-306)"
        },
        {
          "file": "src/renderer/src/components/tab-bar/create-entry/tab-create-entry-absolute-file.ts",
          "mustContain": "externalSshTargetId",
          "why": "SSH paths skip local authorization and stamp their owning target (REQ-302, REQ-304)"
        },
        {
          "file": "src/renderer/src/components/tab-bar/create-entry/TabBarCreateEntry.tsx",
          "mustContain": "useTabEntryAbsolutePathContext",
          "why": "the omnibox offers and validates absolute paths by owning host (REQ-303)"
        },
        {
          "file": "src/renderer/src/i18n/locales/en.json",
          "mustContain": "absolutePathRemoteBlocked",
          "why": "status row copy for an unresolved workspace host (REQ-306)"
        },
        {
          "file": "src/renderer/src/i18n/locales/zh.json",
          "mustContain": "absolutePathRemoteBlocked",
          "why": "Chinese copy for the same status row (REQ-306)"
        }
      ],
      "tests": [
        "src/renderer/src/components/tab-entry-remote-path/absolute-path-host-policy.test.ts",
        "src/renderer/src/components/tab-entry-remote-path/tab-create-entry-action-remote-paths.test.ts",
        "src/renderer/src/components/tab-entry-remote-path/tab-create-entry-classifier-remote-paths.test.ts"
      ],
      "checks": [
        "pnpm exec vitest run --config config/vitest.config.ts src/renderer/src/components/tab-entry-remote-path src/renderer/src/components/tab-bar/create-entry/tab-create-entry-classifier.test.ts src/renderer/src/components/tab-bar/create-entry/tab-create-entry-local-path.test.ts"
      ]
    },
