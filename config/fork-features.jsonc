      ],
      "requiredFiles": [
        "config/scripts/cross-version-wire-fixture-compat/release-candidates.mjs",
        "docs/issue/跨版本Wire夹具兼容/journal.md",
        "docs/issue/跨版本Wire夹具兼容/requirements/跨版本Wire夹具兼容.md"
      ],
      "dependsOn": [
        "config/scripts/release/versioning/stable-release-tags.mjs",
        "tests/e2e/cross-version-wire/release-checkouts/release-module-locations.ts"
      ],
      "seams": [
        {
          "file": "tests/e2e/cross-version-wire/release-checkouts/release-checkout.unit.test.ts",
          "mustContain": "terminal/stream/terminal-stream-protocol.ts",
          "why": "The checkout unit cases cover the shipped and moved terminal protocol paths."
        },
        {
          "file": "tests/e2e/cross-version-wire/release-checkouts/release-checkout.ts",
          "mustContain": "stableReleaseCandidates(REPO_ROOT)",
          "why": "Local baseline and recent refs use the same fork snapshot candidate pool as CI."
        },
        {
          "file": "config/scripts/daemon-protocol/admission/check-daemon-protocol-crossing.mjs",
          "mustContain": "stableReleaseCandidates(repoRoot)",
          "why": "The daemon gate chooses its default from the same fork snapshot candidate pool."
        },
        {
          "file": ".gitignore",
          "mustContain": "!docs/issue/跨版本Wire夹具兼容/**",
          "why": "Track the independent maintenance requirement documents."
        }
      ],
      "tests": [
        "tests/e2e/cross-version-wire/release-checkouts/release-checkout.unit.test.ts",
