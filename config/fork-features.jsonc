{
  // Fork feature registry (Fartown/orca on top of stablyai/orca).
  //
  // Every fork-only capability is listed here so that an upstream sync, a refactor, or an
  // agent session cannot drop it silently: `pnpm check:fork-features` fails when an entry
  // file, a seam registration, a test, or the journal disappears, or when the architecture
  // policy stops budgeting one of its paths. Data only; the checker has no feature branches.
  //
  // Field contract (docs/reference/fork-maintenance.md):
  //   ownedPaths     globs the feature owns outright; each must match at least one file
  //   requiredFiles  entry points that must exist verbatim
  //   seams          upstream files the feature registers into, with the text that proves it
  //   tests          test files that must exist
  //   checks         commands `pnpm sync:upstream` runs after merging upstream
  //   policyId       the policy in config/architecture-policies.jsonc that scopes daily edits
  //   goal           one sentence for the docs/issue index; the requirements doc holds the REQ list
  //   dependsOn      upstream modules the feature imports; each must still exist, and every
  //                  upstream import in owned files must be listed here or in seams
  "schemaVersion": 1,
  "upstream": { "remote": "origin", "branch": "main" },
  "fork": { "remote": "Fartown", "integrationBranch": "fork/integration" },
  // Imports every feature may take without declaring them: the design-system primitives.
  "dependsOnIgnore": ["src/renderer/src/components/ui/**"],
  "features": [
    {
      "id": "goals",
      "title": "Goal 目标模式：原生目标面板、宿主控制服务与合作式驱动",
      "goal": "持久目标、既有会话续跑、独立验收与目标管理 UI",
      "journal": "docs/issue/Goal目标模式/journal.md",
      "dependsOn": [
        "src/cli/runtime/index.ts",
        "src/main/agent-hooks/managed-agent-hook-controls.ts",
        "src/main/agent-hooks/server.ts",
        "src/main/daemon/daemon-process-inspection.ts",
