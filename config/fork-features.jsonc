          "why": "Warm the Linux dependency cache on the same available runners used by fork PR checks."
        },
        {
          "file": ".github/workflows/ci-cache-warmup.yml",
          "mustContain": "github.repository == 'stablyai/orca'",
          "why": "The scheduled warmup runs on fork/integration; a Blacksmith leg would stay queued."
        },
        {
          "file": ".github/workflows/pr.yml",
          "mustContain": "pnpm run check:fork-features",
          "why": "Fork PR gates run the fork registry, docs and fork-diff quality checks in one block."
        },
        {
          "file": ".github/workflows/ci-closed-pr-caches.yml",
          "mustContain": "['fork-integration-build', 'fork-integration-build.yml', '-packages']",
          "why": "Closing a fork PR also cancels its package build concurrency group."
        },
        {
          "file": "mobile/app.config.js",
          "mustContain": "integration-builds",
          "why": "integration-only native version and build marker"
        },
        {
          "file": "mobile/app/_layout.tsx",
          "mustContain": "IntegrationUpdateGate",
          "why": "foreground update checks independent of paired hosts"
        },
        {
          "file": "mobile/src/app-update/app-update-runtime.ts",
          "mustContain": "isIntegrationUpdateChannel",
          "why": "an integration APK never offers upstream's release, which its signing key cannot install over"
        },
        {
          "file": "mobile/src/settings/about-screen.tsx",
          "mustContain": "IntegrationUpdateRow",
          "why": "manual update check and download status"
        },
        {
          "file": "mobile/src/settings/settings-app-update-section.tsx",
          "mustContain": "IntegrationSettingsUpdateSection",
          "why": "Route the integration settings entry to the existing fork update controller and shared status."
        },
        {
          "file": "src/main/updater/lifecycle/updater-scheduling.ts",
          "mustContain": "pinIntegrationReleaseFeed",
          "why": "fork builds resolve their default feed from fork releases"
        },
        {
          "file": "src/main/updater/nudges/updater-nudge.ts",
          "mustContain": "isIntegrationBuild",
          "why": "fork builds do not subscribe to upstream update campaigns"
        },
        {
          "file": "src/main/updater/releases/updater-changelog.ts",
          "mustContain": "integrationChangelog",
          "why": "fork update notes link to the matching fork release"
        },
        {
          "file": "mobile/package.json",
          "mustContain": "zustand",
          "why": "The fork update UI requires its own mobile Zustand dependency; root resolution cannot supply Metro."
        },
        {
          "file": "mobile/pnpm-lock.yaml",
          "mustContain": "zustand",
          "why": "The fork update UI requires its own mobile Zustand dependency; root resolution cannot supply Metro."
        },
        {
          "file": "config/scripts/static-analysis/ratchets/source-budget/check-path-literal-ratchet.mjs",
          "mustContain": "architectureLivePathReferences",
          "why": "Reuse existing contracts while keeping host inventory and historical path semantics explicit."
        },
        {
          "file": "src/main/updater/lifecycle/updater-menu-checks.ts",
          "mustContain": "pinIntegrationReleaseFeed",
          "why": "fork builds resolve their default feed from fork releases (menu-triggered check)"
        }
      ],
      "tests": [
        "src/cli/integration-builds/linux-desktop-launch.test.ts",
        "src/main/integration-builds/linux-appimage-update-availability.test.ts",
