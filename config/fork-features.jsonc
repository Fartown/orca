{
  // Fork feature registry (Fartown/orca on top of stablyai/orca).
  //
  // Every fork-only capability is listed here so that an upstream sync, a refactor, or an
  // agent session cannot drop it silently: `pnpm check:fork-features` fails when an entry
  // file, a seam registration, a test, or the journal disappears, or when the architecture
  // policy stops budgeting one of its paths. Data only; the checker has no feature branches.
  //
  // Field contract (docs/reference/fork-maintenance.md):
  //   ownedPaths     globs the feature owns outright; each must match at least one file
  //   requiredFiles  entry points that must exist verbatim
  //   seams          upstream files the feature registers into, with the text that proves it
  //   tests          test files that must exist
  //   checks         commands `pnpm sync:upstream` runs after merging upstream
  //   policyId       the policy in config/architecture-policies.jsonc that scopes daily edits
  "schemaVersion": 1,
  "upstream": { "remote": "origin", "branch": "main" },
  "fork": { "remote": "Fartown", "integrationBranch": "fork/integration" },
  "features": [
    {
      "id": "goals",
      "title": "Goal 目标模式：原生目标面板、宿主控制服务与合作式驱动",
      "journal": "docs/issue/Goal目标模式/journal.md",
      "policyId": "goals-native-feature",
      "ownedPaths": [
        "src/main/goals/**",
        "src/shared/goals/**",
        "src/renderer/src/goals/**",
        "src/renderer/src/components/goals/**",
        "src/renderer/src/components/cmd-j/goal-quick-actions.ts",
        "src/main/runtime/rpc/methods/goals.ts",
        "src/main/runtime/rpc/methods/goals.test.ts",
        "src/main/startup/main-process-goals.ts",
        "goal-mode/**",
        "config/scripts/build-goal-driver.mjs",
        "docs/issue/Goal目标模式/**"
      ],
      "requiredFiles": [
        "src/main/goals/goal-control-service.ts",
        "src/main/goals/goal-driver-launch.ts",
        "src/main/runtime/rpc/methods/goals.ts",
        "src/main/startup/main-process-goals.ts",
        "src/shared/goals/goal-control-contract.ts",
        "src/renderer/src/components/goals/GoalsPanel.tsx",
        "src/renderer/src/goals/GoalDomainSyncGate.tsx",
        "goal-mode/cli/goal-driver-entry.mjs",
        "goal-mode/cli/goal-loop.mjs",
        "config/scripts/build-goal-driver.mjs"
      ],
      "seams": [
        {
          "file": "src/main/runtime/rpc/methods/index.ts",
          "mustContain": "GOAL_METHODS",
          "why": "goals.* RPC methods are registered in the shared manifest"
        },
        {
          "file": "src/main/index.ts",
          "mustContain": "startGoalFeatureForMainProcess",
          "why": "the host service starts after the terminal runtime"
        },
        {
          "file": "src/main/runtime/rpc/methods/client-ui-schemas.ts",
          "mustContain": "'goals'",
          "why": "the right-sidebar tab id is part of the client UI schema"
        },
        {
          "file": "src/shared/ui-chrome-types.ts",
          "mustContain": "'goals'",
          "why": "the right-sidebar tab union includes goals"
        },
        {
          "file": "src/renderer/src/components/right-sidebar/use-right-sidebar-activity-items.ts",
          "mustContain": "id: 'goals'",
          "why": "the activity bar shows the Goals item"
        },
        {
          "file": "src/renderer/src/components/right-sidebar/right-sidebar-panel-content.tsx",
          "mustContain": "GoalsPanel",
          "why": "the goals tab renders the panel"
        },
        {
          "file": "src/renderer/src/app-shell/AppBackgroundServices.tsx",
          "mustContain": "GoalDomainSyncGate",
          "why": "the domain store is polled while the app runs"
        },
        {
          "file": "src/renderer/src/components/terminal-pane/TerminalPaneHeaderOverlay.tsx",
          "mustContain": "GoalSessionAction",
          "why": "agent panes get the Set goal entry"
        },
        {
          "file": "src/renderer/src/components/cmd-j/quick-actions.ts",
          "mustContain": "getGoalQuickActions",
          "why": "Cmd+J lists the goal actions"
        },
        {
          "file": "src/renderer/src/store/right-sidebar-route.ts",
          "mustContain": "LEGACY_GOAL_PLUGIN_TAB_KEY",
          "why": "persisted routes from the removed plugin land on the native tab"
        },
        {
          "file": "config/electron-builder.config.cjs",
          "mustContain": "out/goal-driver",
          "why": "the driver bundle ships as an extraResource"
        },
        {
          "file": "package.json",
          "mustContain": "build:goal-driver",
          "why": "desktop and release builds bundle the driver"
        },
        {
          "file": "src/renderer/src/i18n/locales/zh.json",
          "mustContain": "\"goals\":",
          "why": "the goals copy namespace exists in the catalog"
        }
      ],
      "tests": [
        "src/main/goals/goal-control-service.test.ts",
        "src/main/goals/goal-driver-launch.test.ts",
        "src/main/goals/goal-revision-control.test.ts",
        "src/main/goals/goal-legacy-adoption.test.ts",
        "src/main/runtime/rpc/methods/goals.test.ts",
        "src/renderer/src/goals/goals-domain-store.test.ts",
        "src/shared/goals/goal-workspace-key.test.ts",
        "goal-mode/cli/goal-driver-control.test.mjs",
        "goal-mode/cli/goal-loop-stop.test.mjs"
      ],
      "checks": [
        "pnpm exec vitest run --config config/vitest.config.ts src/main/goals src/shared/goals src/renderer/src/goals src/renderer/src/components/goals src/main/runtime/rpc/methods/goals.test.ts src/main/plugins/plugin-bundled-bootstrap.test.ts",
        "node --test --experimental-test-module-mocks goal-mode/cli/*.test.mjs"
      ]
    },
    {
      "id": "issues-board",
      "title": "Issues 看板与会话：跨工作区会话组织、恢复与标题稳定",
      "journal": "docs/issue/Issues看板与会话/journal.md",
      "policyId": "issues-existing-capability-reuse",
      "ownedPaths": [
        "src/main/issues/**",
        "src/shared/issues/**",
        "src/renderer/src/issues/**",
        "src/renderer/src/components/issues/**",
        "src/renderer/src/components/sidebar/issues/**",
        "src/main/runtime/rpc/methods/issues.ts",
        "src/main/runtime/rpc/methods/issues.test.ts",
        "tests/e2e/issues-*.spec.ts",
        "tests/e2e/helpers/issues-*.ts",
        "docs/issue/Issues看板与会话/**"
      ],
      "requiredFiles": [
        "src/main/issues/issue-feature-bootstrap.ts",
        "src/main/issues/issue-runtime-service.ts",
        "src/main/runtime/rpc/methods/issues.ts",
        "src/shared/issues/index.ts",
        "src/renderer/src/issues/IssueDomainSyncGate.tsx",
        "src/renderer/src/components/issues/IssuesPage.tsx",
        "src/renderer/src/components/sidebar/issues/issue-sidebar.tsx"
      ],
      "seams": [
        {
          "file": "src/main/runtime/rpc/methods/index.ts",
          "mustContain": "ISSUE_METHODS",
          "why": "issues.* RPC methods are registered in the shared manifest"
        },
        {
          "file": "src/main/index.ts",
          "mustContain": "startIssueFeatureForMainProcess",
          "why": "the Issue host starts after the terminal runtime"
        },
        {
          "file": "src/renderer/src/app-shell/AppBackgroundServices.tsx",
          "mustContain": "IssueDomainSyncGate",
          "why": "the Issue domain store is polled while the app runs"
        },
        {
          "file": "src/renderer/src/app-shell/AppWorkspaceShell.tsx",
          "mustContain": "IssuesPage",
          "why": "the Issue detail page mounts in the workspace shell"
        },
        {
          "file": "src/renderer/src/components/sidebar/index.tsx",
          "mustContain": "SidebarRootModeBar",
          "why": "the sidebar switches between Workspaces and Issues"
        }
      ],
      "tests": [
        "src/main/issues/issue-runtime-service.test.ts",
        "src/main/issues/issue-repository.test.ts",
        "src/main/runtime/rpc/methods/issues.test.ts",
        "src/renderer/src/issues/issues-domain-store.test.ts",
        "src/renderer/src/issues/issue-native-dependency-boundary.test.ts",
        "src/renderer/src/components/sidebar/issues/build-issue-rows.test.ts"
      ],
      "checks": [
        "pnpm exec vitest run --config config/vitest.config.ts src/main/issues src/shared/issues src/renderer/src/issues src/renderer/src/components/issues src/renderer/src/components/sidebar/issues src/main/runtime/rpc/methods/issues.test.ts"
      ]
    },
    {
      "id": "self-hosted-artifacts",
      "title": "自托管产物后端：产物 API origin 放宽到 loopback 与局域网",
      "journal": "docs/issue/自托管产物后端/journal.md",
      "policyId": "self-hosted-artifacts",
      "ownedPaths": ["docs/issue/自托管产物后端/**"],
      "requiredFiles": [
        "src/main/artifacts/artifact-cloud-config.ts",
        "src/main/artifacts/artifact-cloud-config.test.ts"
      ],
      "seams": [
        {
          "file": "src/main/artifacts/artifact-cloud-config.ts",
          "mustContain": "ORCA_ARTIFACTS_API_URL",
          "why": "the API origin can be pointed at a self-hosted server"
        },
        {
          "file": "src/main/artifacts/artifact-cloud-config.ts",
          "mustContain": "allowsArtifactCloudAuthOverride",
          "why": "auth override stays limited to non-packaged builds (REQ-204)"
        }
      ],
      "tests": ["src/main/artifacts/artifact-cloud-config.test.ts"],
      "checks": [
        "pnpm exec vitest run --config config/vitest.config.ts src/main/artifacts/artifact-cloud-config.test.ts"
      ]
    }
  ]
}
