            "src/renderer/src/lib/workspace/creation/worktree-creation-flow-execute.ts",
            "src/renderer/src/lib/workspace/creation/worktree-creation-structured-session.ts"
          ],
          "forbiddenTargets": [
            "src/renderer/src/local-tasks/**",
            "src/renderer/src/components/local-tasks/**",
            "src/renderer/src/components/cmd-j/local-task-quick-actions.ts",
            "src/shared/local-tasks/**"
          ],
          "importTextHints": ["local-tasks", "local-task-quick-actions"],
          "message": "A native renderer module imports the local task feature; mount it through a registered seam instead."
        }
      ]
    },
    {
      "id": "gitea-host-verification",
      "description": "只把确认是 Gitea 的主机当 Gitea；无法确认时保持原行为，探测不带令牌",
      "rules": [
        {
          "id": "gitea-host-verification-worktree-scope",
          "type": "change-scope",
          "comparison": "worktree",
          "whenChanged": ["src/main/gitea-host-verification/**", "docs/issue/Gitea主机识别校验/**"],
          "allowedPaths": [
            "src/main/gitea-host-verification/**",
            "docs/issue/Gitea主机识别校验/**",
            "src/main/gitea/client.ts",
            "src/main/gitea/client-scan-invalidation.test.ts",
            "src/main/source-control/hosted-review-gitea.integration.test.ts",
            "config/fork-features.jsonc",
            "config/architecture-policies.jsonc",
            "docs/issue/README.md",
            ".gitignore"
          ],
          "message": "Change is outside Gitea host verification."
        }
      ]
    },
    {
      "id": "plugin-workspace-remote",
      "description": "插件读到聚焦工作区（本地与 SSH）及工作区列表各行所属仓库的远程地址（去掉凭据），不必在主机上执行命令",
      "rules": [
        {
