{
  // Fork feature registry (Fartown/orca on top of stablyai/orca).
  //
  // Every fork-only capability is listed here so that an upstream sync, a refactor, or an
  // agent session cannot drop it silently: `pnpm check:fork-features` fails when an entry
  // file, a seam registration, a test, or the journal disappears, or when the architecture
  // policy stops budgeting one of its paths. Data only; the checker has no feature branches.
  //
  // Field contract (docs/reference/fork-maintenance.md):
  //   ownedPaths     globs the feature owns outright; each must match at least one file
  //   requiredFiles  entry points that must exist verbatim
  //   seams          upstream files the feature registers into, with the text that proves it
  //   tests          test files that must exist
  //   checks         commands `pnpm sync:upstream` runs after merging upstream
  //   policyId       the policy in config/architecture-policies.jsonc that scopes daily edits
  //   goal           one sentence for the docs/issue index; the requirements doc holds the REQ list
  //   dependsOn      upstream modules the feature imports; each must still exist, and every
  //                  upstream import in owned files must be listed here or in seams
  "schemaVersion": 1,
  "upstream": { "remote": "origin", "branch": "main" },
  "fork": { "remote": "Fartown", "integrationBranch": "fork/integration" },
  // Imports every feature may take without declaring them: the design-system primitives.
  "dependsOnIgnore": ["src/renderer/src/components/ui/**"],
  "features": [
    {
      "id": "integration-builds",
      "title": "集成分支自动出包：同一提交的 macOS 与 Android 内测包",
      "goal": "同源发布 fork 内测包，并提供桌面更新清单和 Android 应用内更新",
      "journal": "docs/issue/集成分支自动出包/journal.md",
      "dependsOn": [
        "config/electron-builder.config.cjs",
        "config/scripts/build-mac-local.mjs",
        "mobile/scripts/prepare-android-release.mjs",
        "mobile/src/theme/mobile-theme.ts",
        "src/main/startup/configure-process.ts",
        "tests/e2e/helpers/e2e-completed-onboarding-profile.ts",
        "tests/e2e/helpers/electron-home-isolation.ts",
        "tests/e2e/helpers/electron-process-shutdown.ts"
      ],
      "policyId": "integration-builds",
      "ownedPaths": [
        ".github/workflows/fork-integration-build.yml",
        "config/scripts/integration-builds/**",
        "src/shared/integration-builds/**",
        "src/main/integration-builds/**",
        "mobile/src/integration-builds/**",
        "mobile/modules/orca-app-update/**",
        "docs/issue/集成分支自动出包/**"
      ],
      "requiredFiles": [
        ".github/workflows/fork-integration-build.yml",
        "config/scripts/integration-builds/electron-builder.cjs",
        "config/scripts/integration-builds/build-identity.mjs",
        "config/scripts/integration-builds/mac-publisher-certificate.pem",
        "config/scripts/integration-builds/publish-release.mjs"
      ],
      "seams": [
        {
          "file": "mobile/app.config.js",
          "mustContain": "integration-builds",
          "why": "integration-only native version and build marker"
        },
        {
          "file": "mobile/app/_layout.tsx",
          "mustContain": "IntegrationUpdateGate",
          "why": "foreground update checks independent of paired hosts"
        },
        {
          "file": "mobile/src/settings/about-screen.tsx",
          "mustContain": "IntegrationUpdateRow",
          "why": "manual update check and download status"
        },
        {
          "file": "src/main/updater/updater-release-feed.ts",
          "mustContain": "pinIntegrationReleaseFeed",
          "why": "fork builds resolve their default feed from fork releases"
        },
        {
          "file": "src/main/updater/updater-nudge.ts",
          "mustContain": "isIntegrationBuild",
          "why": "fork builds do not subscribe to upstream update campaigns"
        },
        {
          "file": "src/main/updater-changelog.ts",
          "mustContain": "integrationChangelog",
          "why": "fork update notes link to the matching fork release"
        }
      ],
      "tests": [
        "config/scripts/integration-builds/integration-builds.test.mjs",
        "config/scripts/integration-builds/mac-signing.test.mjs",
        "config/scripts/integration-builds/mac-package-signature.test.mjs",
        "config/scripts/integration-builds/mac-signing-metadata.test.mjs",
        "config/scripts/integration-builds/signing-probe/probe-policy.test.mjs",
        "config/scripts/integration-builds/orca-update-probe/probe-contract.test.mjs",
        "config/scripts/integration-builds/orca-update-probe/probe-native-relaunch.test.mjs",
        "src/shared/integration-builds/release-catalog.test.ts",
        "src/main/integration-builds/integration-update-feed.test.ts",
        "mobile/src/integration-builds/update-controller.test.ts"
      ],
      "checks": [
        "pnpm exec vitest run --config config/vitest.config.ts config/scripts/integration-builds src/shared/integration-builds src/main/integration-builds",
        "pnpm --dir mobile exec vitest run src/integration-builds"
      ]
    },
    {
      "id": "document-preview-size",
      "title": "文档预览大小：本地、SSH 与配对预览支持 20 MiB",
      "goal": "扩大文档文本预览上限，不扩大普通文件读取和 paired RPC 预算",
      "journal": "docs/issue/文档预览大小/journal.md",
      "dependsOn": ["src/shared/binary-buffer.ts", "src/shared/file-range-read.ts"],
      "policyId": "document-preview-size",
      "ownedPaths": [
        "src/shared/document-preview-size/**",
        "src/main/document-preview-size/**",
        "docs/issue/文档预览大小/**"
      ],
      "requiredFiles": ["src/shared/document-preview-size/document-preview-size-limit.ts"],
      "seams": [
        {
          "file": "src/shared/doc-preview-file-access.ts",
          "mustContain": "DOCUMENT_PREVIEW_TEXT_MAX_BYTES",
          "why": "the execution host accepts the document-specific text limit"
        },
        {
          "file": "src/main/browser/doc-preview-file-reader.ts",
          "mustContain": "DOCUMENT_PREVIEW_TEXT_MAX_BYTES",
          "why": "direct SSH requests the same document-specific text limit"
        },
        {
          "file": "src/main/runtime/runtime-file-commands-read-file-explorer-preview.ts",
          "mustContain": "DOCUMENT_PREVIEW_TEXT_MAX_BYTES",
          "why": "local document reads no longer inherit the mobile text cap"
        },
        {
          "file": "src/main/browser/doc-preview-file-reader.test.ts",
          "mustContain": "maxTextBytes: 20 * 1024 * 1024",
          "why": "existing SSH routing assertions pin the requested cap"
        },
        {
          "file": "src/main/runtime/orca-runtime-files-preview-budget.test.ts",
          "mustContain": "maxTextBytes: 20 * 1024 * 1024",
          "why": "existing runtime routing assertions retain authority and binary limits"
        },
        {
          "file": "src/main/providers/ssh-filesystem-doc-preview.ts",
          "mustContain": "requestGitStreamable",
          "why": "reuse negotiated bulk responses for documents exceeding one relay frame"
        },
        {
          "file": "src/main/providers/ssh-filesystem-doc-preview.test.ts",
          "mustContain": "__streamResponse: true",
          "why": "pin streaming opt-in and legacy relay fallback"
        },
        {
          "file": "src/relay/fs-handler.ts",
          "mustContain": "fs.readDocPreview",
          "why": "document replies reuse the relay's single response stream registry"
        },
        {
          "file": "src/shared/rpc-contract/files-params.ts",
          "mustContain": "DocumentPreviewChunkRequest.optional()",
          "why": "optional scoped chunks retain old-client full-response behavior"
        },
        {
          "file": "src/main/runtime/rpc/methods/files.ts",
          "mustContain": "params.chunk",
          "why": "forward document-specific chunk requests through canonical authorization"
        },
        {
          "file": "src/main/browser/doc-preview-protocol.ts",
          "mustContain": "media-src 'self' data:",
          "why": "inline data: recordings in previewed reports render like inline images instead of failing default-src"
        }
      ],
      "tests": [
        "src/main/document-preview-size/document-preview-size.test.ts",
        "src/main/document-preview-size/document-preview-relay.integration.test.ts",
        "src/main/document-preview-size/document-preview-chunk-reader.test.ts"
      ],
      "checks": [
        "pnpm exec vitest run --config config/vitest.config.ts src/main/document-preview-size src/shared/doc-preview-file-access.test.ts src/main/browser/doc-preview-file-reader.test.ts src/main/browser/doc-preview-protocol.test.ts src/main/runtime/orca-runtime-files-preview-budget.test.ts src/main/runtime/rpc/methods/files-doc-preview.test.ts src/main/providers/ssh-filesystem-doc-preview.test.ts src/relay/fs-list-files-large-response.integration.test.ts"
      ]
    },
