        },
        {
          "file": "skill-guides/orca-cli/references/skill-sharing.md",
          "mustContain": "skill sharing fails with `sharing_unavailable_on_host`",
          "why": "LAN artifact sharing works on headless hosts; only skill sharing is unavailable there"
        }
