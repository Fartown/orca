{
  "schemaVersion": 1,
  "defaultBaseRef": "origin/main",
  "aliases": [
    { "prefix": "@/", "replacement": "src/renderer/src/" },
    { "prefix": "@renderer/", "replacement": "src/renderer/src/" }
  ],
  "policies": [
    {
      "id": "issues-existing-capability-reuse",
      "description": "Keep Issue conversations as adapters over Workspace and AI Vault facts.",
      "rules": [
        {
          "id": "implementation-worktree-scope",
          "type": "change-scope",
          "comparison": "worktree",
          "whenChanged": [
            "src/main/issues/**",
            "src/shared/issues/**",
            "src/renderer/src/issues/**",
            "src/renderer/src/components/issues/**",
            "src/renderer/src/components/sidebar/issues/**",
            "src/renderer/src/components/right-sidebar/ai-vault-provider-session-resolution.ts",
            "src/renderer/src/components/right-sidebar/ai-vault-original-pane-actions.ts",
            "src/renderer/src/components/right-sidebar/ai-vault-session-launch-actions.ts"
          ],
          "allowedPaths": [
            ".docs/并行任务看板/**",
            // Fork infrastructure (docs/reference/fork-maintenance.md).
            "AGENTS.md",
            "config/fork-features.jsonc",
            "config/scripts/check-fork-features.mjs",
            "config/scripts/check-fork-features.test.mjs",
            "config/scripts/run-fork-feature-checks.mjs",
            "config/scripts/check-fork-docs.mjs",
            "config/scripts/check-fork-docs.test.mjs",
            "config/scripts/sync-upstream.mjs",
            ".github/workflows/sync-upstream.yml",
            "docs/reference/fork-maintenance.md",
            "docs/issue/**",
            "docs/maintenance/**",
            "src/renderer/src/components/AiVaultTabTitleSyncGate.tsx",
            "src/renderer/src/components/right-sidebar/use-canonical-session-titles.ts",
            "src/shared/pane-agent-identity-inventory.test.ts",
            "src/renderer/src/components/right-sidebar/AiVaultPanel.tsx",
            "src/renderer/src/components/right-sidebar/AiVaultSessionRow.tsx",
            "src/renderer/src/components/right-sidebar/AiVaultSessionVirtualList.tsx",
            "src/renderer/src/components/right-sidebar/AiVaultVirtualRow.tsx",
            "src/renderer/src/lib/ai-vault-tab-title-sync.ts",
            "src/renderer/src/lib/ai-vault-tab-title-sync.test.ts",
            "src/renderer/src/lib/canonical-session-titles.ts",
            "src/shared/agent-row-conversation-name.ts",
            "src/shared/agent-session-fallback-title.ts",
            "src/shared/agent-session-fallback-title.test.ts",
            "src/shared/ai-vault-session-filters.ts",
            "src/shared/ai-vault-session-filters.test.ts",
            // The host-local title read shared by the tab chain and the Issue
            // refresh. Reads transcripts only; imports no Issue domain module.
            "src/main/ai-vault/session-title-resolver.ts",
            "src/main/ai-vault/session-title-resolver.test.ts",
            // Domain-neutral title projection surfaces. The dependency rule below
            // still forbids these native modules from importing the Issue domain.
            "src/shared/**/*title*.ts",
            "src/shared/**/*session-schema*.ts",
            "src/renderer/src/**/*title*.ts",
            "src/renderer/src/**/*conversation-name*.ts",
            "src/renderer/src/**/*session-tabs-sync*.ts",
            "src/renderer/src/runtime/web-session-tabs-sync/**",
            "src/renderer/src/**/*tab-presentation*.ts",
            "config/electron-builder.config.cjs",
            ".gitignore",
            "docs/requirements/Issues-*.md",
            ".github/workflows/pr.yml",
            "config/architecture-policies.jsonc",
            "docs/reference/architecture-policy-gates.md",
            "config/scripts/architecture-policy-matching.mjs",
            "config/scripts/architecture-policy-manifest.mjs",
            "config/scripts/check-architecture-policies.mjs",
            "config/scripts/check-architecture-policies.test.mjs",
            "package.json",
            "src/main/issues/**",
            "src/shared/issues/**",
            "src/renderer/src/issues/**",
            "src/renderer/src/components/issues/**",
            "src/renderer/src/components/sidebar/issues/**",
            "src/main/index.ts",
            "src/main/startup/main-process-runtime-launch.ts",
            "src/main/runtime/rpc/methods/index.ts",
            "src/main/runtime/rpc/methods/issues.ts",
            "src/main/runtime/rpc/methods/issues.test.ts",
            "src/shared/protocol-version.ts",
            "src/renderer/src/app-shell/AppBackgroundServices.tsx",
            "src/renderer/src/app-shell/AppWorkspaceShell.tsx",
            "src/renderer/src/assets/main.css",
            "src/renderer/src/components/sidebar/index.tsx",
            "src/renderer/src/components/sidebar/Sidebar.test.tsx",
            "src/renderer/src/components/sidebar/sidebar-count-pill.tsx",
            "src/renderer/src/components/sidebar/sidebar-host-badge.tsx",
            "src/renderer/src/components/sidebar/sidebar-row-surface.ts",
            "src/renderer/src/components/right-sidebar/ai-vault-provider-session-resolution.ts",
            "src/renderer/src/components/right-sidebar/ai-vault-original-pane-actions.ts",
            "src/renderer/src/components/right-sidebar/ai-vault-original-pane-actions.test.ts",
            "src/renderer/src/components/right-sidebar/ai-vault-session-launch-actions.ts",
            "src/renderer/src/components/right-sidebar/ai-vault-session-launch-actions.test.ts",
            "src/renderer/src/lib/launch-agent-in-new-tab.ts",
            "src/renderer/src/lib/launch-agent-in-new-tab-web-runtime.test.ts",
            "src/renderer/src/lib/launch-agent-web-host-tab.ts",
            "src/renderer/src/lib/sidebar-worktree-activation.ts",
            "src/renderer/src/lib/sidebar-worktree-activation.test.ts",
            "tests/e2e/*issue*.spec.ts",
            "tests/e2e/conversation-row-parity.spec.ts",
            "tests/e2e/ai-vault-hook-silent-resume-original-pane.spec.ts",
            "tests/e2e/helpers/issues-*.ts",
            "tests/e2e/helpers/packaged-issues-journey.ts",
            "tests/e2e/helpers/runtime-types.ts",
            "tests/e2e/helpers/codex-test-executable*.ts",
            "src/main/ipc/orca-profile-project-transfer-admission.ts",
            "src/main/ipc/orca-profiles.ts",
            "src/main/ipc/orca-profiles.test.ts",
            "src/main/local-worktree-filesystem.ts",
            "src/main/orcad/orcad-entry.ts",
            "src/main/plugins/plugin-host-conformance.test.ts",
            "src/main/runtime/agent-session-claim-identity.ts",
            "src/main/runtime/agent-session-claim-identity.test.ts",
            "src/main/runtime/rpc/errors.ts",
            "src/main/runtime/rpc/errors.test.ts",
            "src/renderer/src/components/dashboard/DashboardAgentRow.tsx",
            "src/renderer/src/components/dashboard/DashboardAgentRowTrailingControls.tsx",
            "src/renderer/src/components/right-sidebar/AiVaultSessionRow.tsx",
            "src/renderer/src/components/right-sidebar/ai-vault-original-pane*.ts",
            "src/renderer/src/components/right-sidebar/ai-vault-original-pane*.tsx",
            "src/renderer/src/components/right-sidebar/ai-vault-session-identity*.ts",
            "src/renderer/src/components/right-sidebar/ai-vault-session-launch-target.ts",
            "src/renderer/src/components/sidebar/WorktreeCardAgents.tsx",
            "src/renderer/src/components/sidebar/WorktreeCardAgents.activation.test.tsx",
            "src/renderer/src/components/sidebar/WorktreeList.folder-workspace-rows.test.ts",
            "src/renderer/src/components/sidebar/workspace-conversation-binding-rows*.tsx",
            "src/renderer/src/components/sidebar/workspace-conversation-binding-rows*.ts",
            "src/renderer/src/components/sidebar/worktree-card-compact-agent-row.tsx",
            "src/renderer/src/components/sidebar/worktree-card-secondary-rows.tsx",
            "src/renderer/src/components/sidebar/worktree-list-lineage-card-test-harness.ts",
            "src/renderer/src/components/sidebar/worktree-list/rows/HostSectionHeader.tsx",
            "src/renderer/src/components/sidebar/worktree-list/rows/folder-row.tsx",
            "src/renderer/src/components/terminal-pane/use-terminal-tab-cold-parking.ts",
            "src/renderer/src/components/right-sidebar/ai-vault-original-pane-index.test.ts",
            "src/renderer/src/components/terminal-pane/pty-connection/sleeping-record-access.ts",
            "src/renderer/src/components/terminal-pane/pty-connection/deferred-cold-restore-and-snapshot.ts",
            "src/renderer/src/components/terminal-pane/pty-connection/resume-identity-launch-config.test.ts",
            "src/renderer/src/components/terminal-pane/pty-connection-agent-session-resume.test.ts",
            "src/renderer/src/components/terminal-pane/pty-connection-sleeping-resume-banner.test.ts",
            "src/renderer/src/lib/ai-vault-tab-title-batches.ts",
            "src/renderer/src/lib/ai-vault-tab-title-sync.ts",
            "src/renderer/src/lib/launch-ai-vault-session.ts",
            "src/renderer/src/lib/launch-ai-vault-session.test.ts",
            "src/renderer/src/runtime/runtime-rpc-environment-call.ts",
            "src/renderer/src/runtime/runtime-rpc-environment-call.test.ts",
            "src/renderer/src/runtime/runtime-rpc-client.ts",
            "src/renderer/src/store/index.ts",
            "src/renderer/src/i18n/locales/en.json",
            "src/renderer/src/i18n/locales/zh.json",
            "src/shared/agent-hook-listener.ts",
            "src/shared/agent-hook-listener/listener-event.ts",
            "src/shared/agent-hook-listener-extraction-characterization.test.ts",
            "src/shared/plugins/plugin-host-api.ts",
            "config/electron-builder.config.cjs",
            "config/scripts/clean-issue-shared-build-output*.mjs",
            "config/scripts/electron-builder-config.test.mjs",
            "config/scripts/verify-packaged-daemon-entry.cjs",
            "config/scripts/verify-packaged-daemon-entry.test.mjs"
          ],
          "message": "Change is outside the reviewed Issue implementation or rollback surface."
        },
        {
          "id": "existing-capability-reference-parity",
          "type": "reference-parity",
          "reference": "$base",
          "whenChanged": [
            "src/main/issues/**",
            "src/shared/issues/**",
            "src/renderer/src/issues/**",
            "src/renderer/src/components/issues/**",
            "src/renderer/src/components/sidebar/issues/**"
          ],
          "paths": [
            "config/scripts/electron-builder-config.test.mjs",
            "config/scripts/verify-packaged-daemon-entry.cjs",
            "config/scripts/verify-packaged-daemon-entry.test.mjs",
            "src/main/ipc/orca-profile-project-transfer-admission.ts",
            "src/main/ipc/orca-profiles.ts",
            "src/main/ipc/orca-profiles.test.ts",
            "src/main/local-worktree-filesystem.ts",
            "src/main/orcad/orcad-entry.ts",
            "src/main/runtime/agent-session-claim-identity.ts",
            "src/main/runtime/agent-session-claim-identity.test.ts",
            "src/main/runtime/rpc/errors.ts",
            "src/main/runtime/rpc/errors.test.ts",
            // 2026-09-05: plugin-host-api.ts and its conformance test left this pin so the
            // bundled goal panel can read storage.get; the conformance suite now asserts the
            // panel/worker split that byte-parity used to protect.
            "src/renderer/src/components/dashboard/DashboardAgentRow.tsx",
            "src/renderer/src/components/dashboard/DashboardAgentRowTrailingControls.tsx",
            "src/renderer/src/components/right-sidebar/ai-vault-original-pane-host-match.ts",
            "src/renderer/src/components/right-sidebar/ai-vault-original-pane-prompt-match.ts",
            "src/renderer/src/components/right-sidebar/ai-vault-session-identity.ts",
            "src/renderer/src/components/right-sidebar/ai-vault-session-identity.test.ts",
            "src/renderer/src/components/right-sidebar/ai-vault-session-launch-target.ts",
            "src/renderer/src/components/sidebar/WorktreeCardAgents.tsx",
            "src/renderer/src/components/sidebar/worktree-card-secondary-rows.tsx",
            "src/renderer/src/components/sidebar/worktree-card-compact-agent-row.tsx",
            "src/renderer/src/components/sidebar/worktree-list/rows/folder-row.tsx",
            "src/renderer/src/components/sidebar/worktree-list/rows/HostSectionHeader.tsx",
            "src/renderer/src/components/sidebar/workspace-conversation-binding-rows.tsx",
            "src/renderer/src/lib/ai-vault-tab-title-batches.ts",
            "src/renderer/src/lib/launch-ai-vault-session.ts",
            "src/renderer/src/lib/launch-ai-vault-session.test.ts",
            "src/renderer/src/runtime/runtime-rpc-environment-call.ts",
            "src/renderer/src/runtime/runtime-rpc-environment-call.test.ts",
            "src/renderer/src/runtime/runtime-rpc-client.ts",
            "src/renderer/src/store/index.ts"
          ],
          "message": "Existing Workspace, AI Vault, Hook, runtime, or unrelated capability must remain at the selected base implementation."
        },
        {
          "id": "main-native-modules-do-not-depend-on-issues",
          "type": "dependency-boundary",
          "sourceFiles": ["src/main/**/*.ts", "src/main/**/*.tsx"],
          "exceptPaths": [
            "src/main/issues/**",
            "src/main/index.ts",
            "src/main/runtime/rpc/methods/issues.ts",
            "src/main/runtime/rpc/methods/index.ts",
            "**/*.test.ts",
            "**/*.test.tsx",
            "**/*.spec.ts",
            "**/*.spec.tsx"
          ],
          "forbiddenTargets": ["src/main/issues/**", "src/shared/issues/**"],
          "importTextHints": ["issues"],
          "message": "A native main-process module imports the Issue domain; move the dependency to an Issue adapter or composition root."
        },
        {
          "id": "renderer-native-modules-do-not-depend-on-issues",
          "type": "dependency-boundary",
          "sourceFiles": [
            "src/renderer/src/**/*.ts",
            "src/renderer/src/**/*.tsx",
            "src/renderer/src/**/*.js",
            "src/renderer/src/**/*.jsx"
          ],
          "exceptPaths": [
            "src/renderer/src/issues/**",
            "src/renderer/src/components/issues/**",
            "src/renderer/src/components/sidebar/issues/**",
            "src/renderer/src/app-shell/AppBackgroundServices.tsx",
            "src/renderer/src/app-shell/AppWorkspaceShell.tsx",
            "src/renderer/src/components/sidebar/index.tsx",
            "**/*.test.ts",
            "**/*.test.tsx",
            "**/*.spec.ts",
            "**/*.spec.tsx"
          ],
          "forbiddenTargets": [
            "src/shared/issues/**",
            "src/renderer/src/issues/**",
            "src/renderer/src/components/issues/**",
            "src/renderer/src/components/sidebar/issues/**"
          ],
          "importTextHints": ["issues"],
          "message": "A native renderer module imports the Issue domain; keep Issue semantics in adapters and composition roots."
        },
        {
          "id": "removed-parallel-lifecycle-files-stay-absent",
          "type": "forbidden-path",
          "paths": [
            "src/**/provider-resume-observation*.ts",
            "src/**/*certified*exit*.ts",
            "src/renderer/src/issues/issue-conversation-pending-tab*.ts",
            "src/renderer/src/issues/issue-resume-bookkeeping*.ts",
            "src/renderer/src/issues/issue-conversation-launch-observer*.ts",
            "src/renderer/src/issues/issue-conversation-launch-failure*.ts",
            "src/renderer/src/issues/ai-vault-session-title-cache*.ts",
            "src/renderer/src/components/sidebar/workspace-conversation-binding-rows*.ts",
            "src/renderer/src/components/sidebar/workspace-conversation-binding-rows*.tsx",
            "src/renderer/src/components/right-sidebar/ai-vault-original-pane-host-match.ts",
            "src/renderer/src/components/right-sidebar/ai-vault-original-pane-prompt-match.ts",
            "tests/e2e/issue-conversation-unconfirmed-retry.spec.ts"
          ],
          "message": "A removed parallel lifecycle, cache, or native-capability rewrite has been reintroduced."
        },
        {
          "id": "issues-do-not-own-runtime-liveness",
          "type": "forbidden-content",
          "files": [
            "src/main/issues/**/*.ts",
            "src/shared/issues/**/*.ts",
            "src/renderer/src/issues/**/*.ts",
            "src/renderer/src/issues/**/*.tsx",
            "src/renderer/src/components/issues/**/*.ts",
            "src/renderer/src/components/issues/**/*.tsx",
            "src/renderer/src/components/sidebar/issues/**/*.ts",
            "src/renderer/src/components/sidebar/issues/**/*.tsx"
          ],
          "exceptPaths": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"],
          "patterns": [
            {
              "id": "issue-liveness-verdict",
              "regex": "\\b(?:ConversationLivenessVerdict|livenessVerdict|unverifiableByRuntimeKey)\\b",
              "message": "Issue owns a second runtime liveness verdict instead of projecting existing Workspace or AI Vault facts."
            }
          ]
        },
        {
          "id": "renderer-adapters-do-not-own-launch-lifecycle",
          "type": "forbidden-content",
          "files": [
            "src/renderer/src/issues/issue-conversation-*.ts",
            "src/renderer/src/issues/conversation-session-titles.ts",
            "src/renderer/src/components/issues/IssueConversationList.tsx",
            "src/renderer/src/components/issues/IssueConversationRowContent.tsx",
            "src/renderer/src/components/issues/issue-conversation-launch-action.ts",
            "src/renderer/src/components/sidebar/issues/build-issue-rows.ts"
          ],
          "exceptPaths": ["**/*.test.ts", "**/*.test.tsx"],
          "patterns": [
            {
              "id": "renderer-retry-state",
              "regex": "\\b(?:recordLaunchFailure|prepareRetry|executionState|launchFailure)\\b",
              "message": "Renderer adapter owns a second launch failure or retry projection."
            },
            {
              "id": "native-startup-state",
              "regex": "\\b(?:automaticAgentResumeClaimsByTabId|pendingStartupByTabId|agentLaunchConfigByPaneKey)\\b",
              "message": "Issue adapter reads native startup bookkeeping instead of reusing the native UI result."
            },
            {
              "id": "adapter-polling",
              "regex": "\\bsetInterval\\s*\\(",
              "message": "Issue navigation or title adapter introduced a polling lifecycle."
            }
          ]
        },
        {
          "id": "ai-vault-seams-stay-domain-neutral",
          "type": "forbidden-content",
          "files": [
            "src/renderer/src/components/right-sidebar/ai-vault-provider-session-resolution.ts",
            "src/renderer/src/components/right-sidebar/ai-vault-original-pane-actions.ts",
            "src/renderer/src/components/right-sidebar/ai-vault-session-launch-actions.ts"
          ],
          "patterns": [
            {
              "id": "issue-identity-in-native-seam",
              "regex": "\\b(?:issueId|conversationId)\\b",
              "message": "AI Vault seam accepts Issue-domain identity instead of a neutral session input."
            }
          ]
        }
      ]
    },
    {
      "id": "fork-upstream-diff-budget",
      "description": "The fork's whole diff against upstream stays inside one reviewed allowlist: feature-owned paths plus the seams they register into.",
      "rules": [
        {
          "id": "fork-integration-scope",
          "type": "change-scope",
          "comparison": "base",
          "baseRef": "$base",
          "requireBaseAncestor": true,
          "allowedPaths": [
            // Fork infrastructure (docs/reference/fork-maintenance.md).
            "AGENTS.md",
            "config/fork-features.jsonc",
            "config/scripts/check-fork-features.mjs",
            "config/scripts/check-fork-features.test.mjs",
            "config/scripts/run-fork-feature-checks.mjs",
            "config/scripts/check-fork-docs.mjs",
            "config/scripts/check-fork-docs.test.mjs",
            "config/scripts/sync-upstream.mjs",
            ".github/workflows/sync-upstream.yml",
            "docs/reference/fork-maintenance.md",
            "docs/issue/**",
            "docs/maintenance/**",
            // Every fork feature's owned paths and seams. config/fork-features.jsonc is
            // cross-checked against this list by check:fork-features.
            ".docs/并行任务看板/**",
            // 2026-08-31: single-branch delivery decision — goal-mode and the self-hosted
            // artifact backend ship on this same branch alongside Issues.
            "goal-mode/**",
            // 2026-09-05: goal-mode ships as the bundled plugin stablyai.orca-goal,
            // so this branch also owns its launch payload.
            "resources/plugins/launch/bundled-plugins.json",
            "resources/plugins/launch/stablyai.orca-goal/**",
            "src/main/plugins/plugin-launch-content.test.ts",
            "src/main/plugins/plugin-bundled-bootstrap.ts",
            "src/main/plugins/plugin-bundled-bootstrap.test.ts",
            "src/main/plugins/plugin-bundled-bootstrap-coordinator.ts",
            "src/main/plugins/plugin-bundled-bootstrap-coordinator.test.ts",
            "src/main/startup/main-process-plugins.ts",
            "config/vitest.config.ts",
            // 2026-09-06: goal management UI (docs/issue/Goal目标模式/solutions/Goal目标管理与交互闭环方案.md §5.10).
            "src/main/goals/**",
            "src/shared/goals/**",
            "src/main/runtime/rpc/methods/goals.ts",
            "src/main/runtime/rpc/methods/goals.test.ts",
            "src/main/startup/main-process-goals.ts",
            "src/main/startup/main-process-runtime-service.ts",
            "src/shared/ui-chrome-types.ts",
            "src/renderer/src/goals/**",
            "src/renderer/src/components/goals/**",
            "src/renderer/src/store/right-sidebar-route.ts",
            "src/renderer/src/components/right-sidebar/use-right-sidebar-activity-items.ts",
            "src/renderer/src/components/right-sidebar/right-sidebar-panel-content.tsx",
            "src/renderer/src/components/terminal-pane/TerminalPaneHeaderOverlay.tsx",
            "src/renderer/src/components/terminal-pane/TerminalPaneSurface.tsx",
            "src/renderer/src/components/cmd-j/goal-quick-actions.ts",
            "src/renderer/src/components/cmd-j/quick-actions.ts",
            "src/main/runtime/rpc/methods/client-ui-schemas.ts",
            "src/renderer/src/app-shell/AppBackgroundServices.tsx",
            "src/renderer/src/store/right-sidebar-route.test.ts",
            "src/renderer/src/components/terminal-pane/TerminalPaneHeaderOverlay.test.tsx",
            "src/renderer/src/components/right-sidebar/use-right-sidebar-activity-items.test.ts",
            "src/renderer/src/i18n/**",
            "config/scripts/build-goal-driver.mjs",
            "config/scripts/electron-builder-runtime-resources.test.mjs",
            "docs/issue/Goal目标模式/**",
            // Its panel reads storage.get, which the host must expose to panels.
            "src/shared/plugins/plugin-host-api.ts",
            "src/main/plugins/plugin-host-conformance.test.ts",
            "src/main/artifacts/**",
            "src/renderer/src/components/AiVaultTabTitleSyncGate.tsx",
            "src/renderer/src/components/right-sidebar/use-canonical-session-titles.ts",
            "src/shared/pane-agent-identity-inventory.test.ts",
            "src/renderer/src/components/right-sidebar/AiVaultPanel.tsx",
            "src/renderer/src/components/right-sidebar/AiVaultSessionRow.tsx",
            "src/renderer/src/components/right-sidebar/AiVaultSessionVirtualList.tsx",
            "src/renderer/src/components/right-sidebar/AiVaultVirtualRow.tsx",
            "src/renderer/src/lib/ai-vault-tab-title-sync.ts",
            "src/renderer/src/lib/ai-vault-tab-title-sync.test.ts",
            "src/renderer/src/lib/canonical-session-titles.ts",
            "src/shared/agent-row-conversation-name.ts",
            "src/shared/agent-session-fallback-title.ts",
            "src/shared/agent-session-fallback-title.test.ts",
            "src/shared/ai-vault-session-filters.ts",
            "src/shared/ai-vault-session-filters.test.ts",
            // The host-local title read shared by the tab chain and the Issue
            // refresh. Reads transcripts only; imports no Issue domain module.
            "src/main/ai-vault/session-title-resolver.ts",
            "src/main/ai-vault/session-title-resolver.test.ts",
            // Domain-neutral title projection surfaces. The dependency rule below
            // still forbids these native modules from importing the Issue domain.
            "src/shared/**/*title*.ts",
            "src/shared/**/*session-schema*.ts",
            "src/renderer/src/**/*title*.ts",
            "src/renderer/src/**/*conversation-name*.ts",
            "src/renderer/src/**/*session-tabs-sync*.ts",
            "src/renderer/src/runtime/web-session-tabs-sync/**",
            "src/renderer/src/**/*tab-presentation*.ts",
            "config/electron-builder.config.cjs",
            ".gitignore",
            "docs/requirements/Issues-*.md",
            ".github/workflows/pr.yml",
            "config/architecture-policies.jsonc",
            "docs/reference/architecture-policy-gates.md",
            "config/scripts/architecture-policy-matching.mjs",
            "config/scripts/architecture-policy-manifest.mjs",
            "config/scripts/check-architecture-policies.mjs",
            "config/scripts/check-architecture-policies.test.mjs",
            "package.json",
            "src/main/index.ts",
            "src/main/startup/main-process-runtime-launch.ts",
            "src/main/issues/**",
            "src/main/native-chat/transcript-line-decoders-codex.ts",
            "src/main/native-chat/transcript-reader-codex-history-mode.test.ts",
            "src/main/runtime/rpc/methods/index.ts",
            "src/main/runtime/rpc/methods/issues.ts",
            "src/main/runtime/rpc/methods/issues.test.ts",
            "src/shared/issues/**",
            "src/shared/protocol-version.ts",
            "src/shared/codex-thread-title-generation.ts",
            "src/shared/agent-hook-listener.ts",
            "src/shared/agent-hook-listener/listener-event.ts",
            "src/shared/agent-hook-listener-extraction-characterization.test.ts",
            "src/shared/pane-agent-identity-inventory.test.ts",
            "src/renderer/src/app-shell/AppBackgroundServices.tsx",
            "src/renderer/src/app-shell/AppWorkspaceShell.tsx",
            "src/renderer/src/assets/main.css",
            "src/renderer/src/issues/**",
            "src/renderer/src/components/issues/**",
            "src/renderer/src/components/sidebar/issues/**",
            "src/renderer/src/components/sidebar/index.tsx",
            "src/renderer/src/components/sidebar/Sidebar.test.tsx",
            "src/renderer/src/components/sidebar/sidebar-count-pill.tsx",
            "src/renderer/src/components/sidebar/sidebar-host-badge.tsx",
            "src/renderer/src/components/sidebar/sidebar-row-surface.ts",
            "src/renderer/src/components/right-sidebar/ai-vault-provider-session-resolution.ts",
            "src/renderer/src/components/right-sidebar/ai-vault-original-pane-actions.ts",
            "src/renderer/src/components/right-sidebar/ai-vault-original-pane-actions.test.ts",
            "src/renderer/src/components/right-sidebar/ai-vault-session-launch-actions.ts",
            "src/renderer/src/components/right-sidebar/ai-vault-session-launch-actions.test.ts",
            "src/renderer/src/components/right-sidebar/ai-vault-original-pane.ts",
            "src/renderer/src/components/right-sidebar/ai-vault-original-pane.test.ts",
            "src/renderer/src/components/right-sidebar/ai-vault-original-pane-index.ts",
            "src/renderer/src/components/right-sidebar/ai-vault-original-pane-index.test.ts",
            "src/renderer/src/components/terminal-pane/pty-connection/sleeping-record-access.ts",
            "src/renderer/src/components/terminal-pane/pty-connection/deferred-cold-restore-and-snapshot.ts",
            "src/renderer/src/components/terminal-pane/pty-connection/resume-identity-launch-config.test.ts",
            "src/renderer/src/components/terminal-pane/pty-connection-agent-session-resume.test.ts",
            "src/renderer/src/components/terminal-pane/pty-connection-sleeping-resume-banner.test.ts",
            "src/renderer/src/lib/launch-agent-in-new-tab.ts",
            "src/renderer/src/lib/launch-agent-in-new-tab-web-runtime.test.ts",
            "src/renderer/src/lib/launch-agent-web-host-tab.ts",
            "src/renderer/src/lib/sidebar-worktree-activation.ts",
            "src/renderer/src/lib/sidebar-worktree-activation.test.ts",
            "src/renderer/src/i18n/locales/en.json",
            "src/renderer/src/i18n/locales/zh.json",
            "tests/e2e/*issue*.spec.ts",
            "tests/e2e/conversation-row-parity.spec.ts",
            "tests/e2e/ai-vault-hook-silent-resume-original-pane.spec.ts",
            "tests/e2e/fixtures/golden-stub-agent/golden-stub-agent.js",
            "tests/e2e/helpers/issues-*.ts",
            "tests/e2e/helpers/packaged-issues-journey.ts",
            "tests/e2e/helpers/runtime-types.ts",
            "tests/e2e/helpers/codex-test-executable*.ts"
          ],
          "message": "Branch changes an upstream path that no fork feature owns or registers as a seam; extend config/fork-features.jsonc and this allowlist, or move the change into a feature-owned path."
        }
      ]
    },
    {
      "id": "goals-native-feature",
      "description": "Goals stay a native host feature with one reviewed set of seams into the runtime, the right sidebar and packaging.",
      "rules": [
        {
          "id": "goals-worktree-scope",
          "type": "change-scope",
          "comparison": "worktree",
          "whenChanged": [
            "src/main/goals/**",
            "src/shared/goals/**",
            "src/renderer/src/goals/**",
            "src/renderer/src/components/goals/**",
            "goal-mode/**"
          ],
          "allowedPaths": [
            "src/main/goals/**",
            "src/shared/goals/**",
            "src/renderer/src/goals/**",
            "src/renderer/src/components/goals/**",
            "src/renderer/src/components/cmd-j/goal-quick-actions.ts",
            "src/main/runtime/rpc/methods/goals.ts",
            "src/main/runtime/rpc/methods/goals.test.ts",
            "src/main/startup/main-process-goals.ts",
            "goal-mode/**",
            "config/scripts/build-goal-driver.mjs",
            "docs/issue/Goal目标模式/**",
            "src/main/index.ts",
            "src/main/runtime/rpc/methods/index.ts",
            "src/main/runtime/rpc/methods/client-ui-schemas.ts",
            "src/shared/ui-chrome-types.ts",
            "src/renderer/src/components/right-sidebar/use-right-sidebar-activity-items.ts",
            "src/renderer/src/components/right-sidebar/use-right-sidebar-activity-items.test.ts",
            "src/renderer/src/components/right-sidebar/right-sidebar-panel-content.tsx",
            "src/renderer/src/app-shell/AppBackgroundServices.tsx",
            "src/renderer/src/components/terminal-pane/TerminalPaneHeaderOverlay.tsx",
            "src/renderer/src/components/terminal-pane/TerminalPaneHeaderOverlay.test.tsx",
            "src/renderer/src/components/cmd-j/quick-actions.ts",
            "src/renderer/src/store/right-sidebar-route.ts",
            "src/renderer/src/store/right-sidebar-route.test.ts",
            "src/renderer/src/i18n/**",
            "config/electron-builder.config.cjs",
            "config/scripts/electron-builder-runtime-resources.test.mjs",
            "config/vitest.config.ts",
            "package.json",
            "resources/plugins/launch/bundled-plugins.json",
            "resources/plugins/launch/stablyai.orca-goal/**",
            "src/main/plugins/plugin-launch-content.test.ts",
            "src/main/plugins/plugin-bundled-bootstrap.ts",
            "src/main/plugins/plugin-bundled-bootstrap.test.ts",
            "src/main/plugins/plugin-bundled-bootstrap-coordinator.ts",
            "src/main/plugins/plugin-bundled-bootstrap-coordinator.test.ts",
            "src/main/startup/main-process-plugins.ts",
            "config/architecture-policies.jsonc",
            ".docs/并行任务看板/**",
            "AGENTS.md",
            "config/fork-features.jsonc",
            "config/scripts/check-fork-features.mjs",
            "config/scripts/check-fork-features.test.mjs",
            "config/scripts/run-fork-feature-checks.mjs",
            "config/scripts/check-fork-docs.mjs",
            "config/scripts/check-fork-docs.test.mjs",
            "config/scripts/sync-upstream.mjs",
            ".github/workflows/sync-upstream.yml",
            "docs/reference/fork-maintenance.md",
            "docs/issue/**",
            "docs/maintenance/**"
          ],
          "message": "Change is outside the Goal feature and its reviewed seams."
        },
        {
          "id": "main-native-modules-do-not-depend-on-goals",
          "type": "dependency-boundary",
          "sourceFiles": ["src/main/**/*.ts", "src/main/**/*.tsx"],
          "exceptPaths": [
            "src/main/goals/**",
            "src/main/index.ts",
            "src/main/startup/main-process-goals.ts",
            "src/main/runtime/rpc/methods/goals.ts",
            "src/main/runtime/rpc/methods/index.ts",
            "**/*.test.ts",
            "**/*.test.tsx",
            "**/*.spec.ts",
            "**/*.spec.tsx"
          ],
          "forbiddenTargets": ["src/main/goals/**", "src/shared/goals/**"],
          "importTextHints": ["goals"],
          "message": "A native main-process module imports the Goal domain; register through main-process-goals.ts or the RPC manifest instead."
        },
        {
          "id": "renderer-native-modules-do-not-depend-on-goals",
          "type": "dependency-boundary",
          "sourceFiles": ["src/renderer/src/**/*.ts", "src/renderer/src/**/*.tsx"],
          "exceptPaths": [
            "src/renderer/src/goals/**",
            "src/renderer/src/components/goals/**",
            "src/renderer/src/components/cmd-j/goal-quick-actions.ts",
            "src/renderer/src/components/cmd-j/quick-actions.ts",
            "src/renderer/src/app-shell/AppBackgroundServices.tsx",
            "src/renderer/src/components/right-sidebar/right-sidebar-panel-content.tsx",
            "src/renderer/src/components/terminal-pane/TerminalPaneHeaderOverlay.tsx",
            "**/*.test.ts",
            "**/*.test.tsx",
            "**/*.spec.ts",
            "**/*.spec.tsx"
          ],
          "forbiddenTargets": [
            "src/shared/goals/**",
            "src/renderer/src/goals/**",
            "src/renderer/src/components/goals/**"
          ],
          "importTextHints": ["goals"],
          "message": "A native renderer module imports the Goal domain; keep Goal semantics behind the panel, the sync gate and the listed seams."
        },
        {
          "id": "removed-goal-plugin-stays-absent",
          "type": "forbidden-path",
          "paths": ["resources/plugins/launch/stablyai.orca-goal/**", "goal-mode/plugin/**"],
          "message": "The bundled Goal plugin was replaced by the native feature; do not reintroduce it."
        }
      ]
    },
    {
      "id": "self-hosted-artifacts",
      "description": "The artifact API origin can point at loopback or LAN servers; auth, profiles and the request chain stay upstream (REQ-204).",
      "rules": [
        {
          "id": "self-hosted-artifacts-worktree-scope",
          "type": "change-scope",
          "comparison": "worktree",
          "whenChanged": [
            "src/main/artifacts/artifact-cloud-config.ts",
            "src/main/artifacts/artifact-cloud-config.test.ts",
            "docs/issue/自托管产物后端/**"
          ],
          "allowedPaths": [
            "src/main/artifacts/artifact-cloud-config.ts",
            "src/main/artifacts/artifact-cloud-config.test.ts",
            "docs/issue/自托管产物后端/**",
            "config/architecture-policies.jsonc",
            "AGENTS.md",
            "config/fork-features.jsonc",
            "config/scripts/check-fork-features.mjs",
            "config/scripts/check-fork-features.test.mjs",
            "config/scripts/run-fork-feature-checks.mjs",
            "config/scripts/check-fork-docs.mjs",
            "config/scripts/check-fork-docs.test.mjs",
            "config/scripts/sync-upstream.mjs",
            ".github/workflows/sync-upstream.yml",
            "docs/reference/fork-maintenance.md",
            "docs/issue/**",
            "docs/maintenance/**"
          ],
          "message": "Change is outside the self-hosted artifact backend and its journal."
        }
      ]
    }
  ]
}
