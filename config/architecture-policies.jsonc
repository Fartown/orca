            "src/renderer/src/components/terminal-pane/titles/TerminalPaneHeaderOverlay.tsx",
            "src/renderer/src/components/native-chat/NativeChatStructuredSession.tsx",
            "src/renderer/src/hooks/composer-state/submission/quick-creation-execution.ts",
            "src/renderer/src/hooks/composer-state/submission/quick-creation-request.ts",
            "src/renderer/src/lib/workspace/creation/worktree-creation-completion.ts",
            "src/renderer/src/hooks/composer-state/workspace-target/composer-target-store.ts",
            "src/renderer/src/components/settings/tasks/TasksPane.tsx",
            "src/renderer/src/components/new-workspace/name-field/smart-workspace-name-field-model.ts",
            "src/renderer/src/components/new-workspace/source-search/use-smart-workspace-field-availability.ts",
            "src/renderer/src/components/new-workspace/source-search/use-work-item-source-search.ts",
            "src/renderer/src/components/new-workspace/source-search/smart-workspace-source-row-content.tsx",
            "src/renderer/src/components/new-workspace/source-search/SmartWorkspaceSourceResultList.tsx",
            "src/renderer/src/components/sidebar/workspace-card/metadata/WorktreeLinkedItemsField.tsx",
            "src/renderer/src/components/sidebar/workspace-card/metadata/WorktreeMetaDialogDraft.tsx",
            "src/renderer/src/components/sidebar/workspace-card/metadata/WorktreeMetaDialog.tsx",
            "src/renderer/src/hooks/app-commands/new-workspace-command.ts",
            "src/renderer/src/app-shell/AppWorkspaceShell.tsx",
            "src/renderer/src/components/terminal/workbench/use-terminal-workspace-store-bindings.ts",
            "src/renderer/src/components/sidebar/index.tsx",
            "src/renderer/src/components/sidebar/chrome/SidebarHeader.tsx",
            "src/renderer/src/components/native-chat/composer/NativeChatComposer.tsx",
            "src/renderer/src/lib/agent-session/messaging/terminal/active-agent-note-target.ts",
