{
  // Fork feature registry (Fartown/orca on top of stablyai/orca).
  //
  // Every fork-only capability is listed here so that an upstream sync, a refactor, or an
  // agent session cannot drop it silently: `pnpm check:fork-features` fails when an entry
  // file, a seam registration, a test, or the journal disappears, or when the architecture
  // policy stops budgeting one of its paths. Data only; the checker has no feature branches.
  //
  // Field contract (docs/reference/fork-maintenance.md):
  //   ownedPaths     globs the feature owns outright; each must match at least one file
  //   requiredFiles  entry points that must exist verbatim
  //   seams          upstream files the feature registers into, with the text that proves it
  //   tests          test files that must exist
  //   checks         commands `pnpm sync:upstream` runs after merging upstream
  //   policyId       the policy in config/architecture-policies.jsonc that scopes daily edits
  //   goal           one sentence for the docs/issue index; the requirements doc holds the REQ list
  //   dependsOn      upstream modules the feature imports; each must still exist, and every
  //                  upstream import in owned files must be listed here or in seams
  "schemaVersion": 1,
  "upstream": { "remote": "origin", "branch": "main" },
  "fork": { "remote": "Fartown", "integrationBranch": "fork/integration" },
  // Imports every feature may take without declaring them: the design-system primitives.
  "dependsOnIgnore": ["src/renderer/src/components/ui/**"],
  "features": [
    {
      "id": "terminal-shell-mode-recovery",
      "title": "终端退出模式恢复",
      "goal": "消费当前执行主机的 shell 前台观察，清理退出后残留的鼠标和键盘模式",
      "journal": "docs/issue/终端退出模式恢复/journal.md",
      "policyId": "terminal-shell-mode-recovery",
      "ownedPaths": [
        "src/main/terminal-shell-mode-recovery/**",
        "src/shared/terminal-shell-mode-recovery/**",
        "src/renderer/src/terminal-shell-mode-recovery/**",
        "docs/issue/终端退出模式恢复/**"
      ],
      "requiredFiles": ["src/shared/terminal-shell-mode-recovery/host-foreground-observation.ts"],
      "dependsOn": [
        "src/shared/terminal/pty/lifecycle/terminal-foreground-observation.ts",
        "src/shared/terminal/pty/foreground/remote-foreground-evidence-admission.ts"
      ],
      "seams": [
        {
          "file": "src/shared/rpc-contract/terminal/terminal-unary-params.ts",
          "mustContain": "TERMINAL_FOREGROUND_INSPECTION_PARAMS",
          "why": "Carry the additive host foreground-only request and its original terminal identity."
        },
        {
          "file": "src/main/runtime/rpc/methods/terminal/terminal-query-methods.ts",
          "mustContain": "foregroundOnly",
          "why": "Carry the additive host foreground-only request and its original terminal identity."
        },
        {
          "file": "src/main/runtime/session-tabs/chat/structured-session-tab-restoration.ts",
          "mustContain": "foregroundObservation",
          "why": "Carry the additive host foreground-only request and its original terminal identity."
        },
        {
          "file": "src/renderer/src/runtime/hosted-terminals/inspection/runtime-terminal-process-inspection.ts",
          "mustContain": "foregroundOnly",
          "why": "Carry the additive host foreground-only request and its original terminal identity."
        },
        {
          "file": "src/renderer/src/components/terminal-pane/pty-connection/agent-identity/pane-agent-identity.ts",
          "mustContain": "foregroundOnly",
          "why": "Carry the additive host foreground-only request and its original terminal identity."
        },
        {
          "file": "src/preload/api/terminal/pty-api.ts",
          "mustContain": "foregroundOnly",
          "why": "Carry the additive host foreground-only request and its original terminal identity."
        },
        {
          "file": "src/preload/api/terminal/pty-bridge-stream-and-serialization.ts",
          "mustContain": "foregroundOnly",
          "why": "Carry the additive host foreground-only request and its original terminal identity."
        },
        {
          "file": "src/main/ipc/pty/ipc/inspect.ts",
          "mustContain": "foregroundOnly",
          "why": "Carry the additive host foreground-only request and its original terminal identity."
        },

        {
          "file": "src/shared/terminal/pty/foreground/remote-foreground-evidence-admission.ts",
          "mustContain": "isCurrentForegroundObservation",
          "why": "Reuse the existing PTY, incarnation, freshness and authority admission for explicit foreground observations."
        },
        {
          "file": "src/renderer/src/components/terminal-pane/pty-connection/agent-identity/foreground-process/pane-foreground-process-reader.ts",
          "mustContain": "createHostForegroundObservationReader",
          "why": "Preserve execution-host shell proof even when no process name is returned."
        },
        {
          "file": "src/renderer/src/components/terminal-pane/pty-connection/agent-identity/foreground-process/pane-foreground-agent-tracker.ts",
          "mustContain": "shellForeground === true",
          "why": "Use explicit host shell proof to reach the existing mode reset callback."
        }
      ],
      "tests": ["src/renderer/src/terminal-shell-mode-recovery/host-shell-return.test.ts"],
      "checks": [
        "ORCA_BACKGROUND_LAUNCH=1 pnpm exec vitest run --config config/vitest.config.ts src/main/terminal-shell-mode-recovery src/shared/terminal-shell-mode-recovery src/renderer/src/terminal-shell-mode-recovery src/renderer/src/components/terminal-pane/pty-connection/tests/pty-connection-foreground-agent.test.ts src/renderer/src/components/terminal-pane/pane-foreground-agent-contact.test.ts src/renderer/src/runtime/runtime-terminal-inspection-contact.test.ts --maxWorkers=2"
      ]
